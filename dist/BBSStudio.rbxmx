    </Item>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CameraTrack</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Camera keyframes: { t, cf, fov, ease }. The ease of a key controls the segment that starts at it.
local HttpService = game:GetService("HttpService")
local Codec = require(script.Parent.Codec)

local CameraTrack = {}

CameraTrack.EASES = { "linear", "smooth", "in", "out", "cut" }
CameraTrack.EASE_LABELS = {
	linear = "Ровно",
	smooth = "Плавно",
	["in"] = "Разгон",
	out = "Торможение",
	cut = "Склейка",
}

local EASE = {
	linear = function(a)
		return a
	end,
	smooth = function(a)
		return a * a * (3 - 2 * a)
	end,
	["in"] = function(a)
		return a * a
	end,
	out = function(a)
		return 1 - (1 - a) * (1 - a)
	end,
	-- hold this shot until the next key, then jump: a hard cut between shots
	cut = function(_a)
		return 0
	end,
}

function CameraTrack.new()
	return { interp = "catmull", keys = {} }
end

function CameraTrack.sort(track)
	table.sort(track.keys, function(a, b)
		return a.t < b.t
	end)
end

function CameraTrack.decode(str: string?)
	local track = CameraTrack.new()
	if type(str) ~= "string" or str == "" then
		return track
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(str)
	end)
	if not ok or type(data) ~= "table" then
		return track
	end
	track.interp = data.interp or "catmull"
	for _, k in data.keys or {} do
		table.insert(track.keys, {
			t = tonumber(k.t) or 0,
			cf = Codec.arrayToCFrame(k.p or {}, 1),
			fov = tonumber(k.fov) or 70,
			ease = if EASE[k.ease] then k.ease else "linear",
		})
	end
	CameraTrack.sort(track)
	return track
end

function CameraTrack.encode(track): string
	local keys = {}
	for i, k in track.keys do
		local p = Codec.cframeToArray(k.cf)
		for j, v in p do
			p[j] = math.floor(v * 10000 + 0.5) / 10000
		end
		keys[i] = { t = k.t, p = p, fov = k.fov, ease = k.ease }
	end
	return HttpService:JSONEncode({ interp = track.interp, keys = keys })
end

local function catmull(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, a: number): Vector3
	local a2 = a * a
	local a3 = a2 * a
	return 0.5
		* ((2 * p1) + (p2 - p0) * a + (2 * p0 - 5 * p1 + 4 * p2 - p3) * a2 + (3 * p1 - p0 - 3 * p2 + p3) * a3)
end

function CameraTrack.evaluate(track, t: number): (CFrame?, number?)
	local keys = track.keys
	local n = #keys
	if n == 0 then
		return nil, nil
	end
	if n == 1 or t <= keys[1].t then
		return keys[1].cf, keys[1].fov
	end
	if t >= keys[n].t then
		return keys[n].cf, keys[n].fov
	end
	local i = 1
	while i < n - 1 and keys[i + 1].t <= t do
		i += 1
	end
	local k1, k2 = keys[i], keys[i + 1]
	local span = k2.t - k1.t
	local a = if span > 0 then math.clamp((t - k1.t) / span, 0, 1) else 1
	a = (EASE[k1.ease] or EASE.linear)(a)

	local pos
	if track.interp == "catmull" then
		local prev = keys[i - 1]
		local nextKey = keys[i + 2]
		-- a cut breaks the spline, so neighbours across it are ignored
		local p0 = if prev and prev.ease ~= "cut" then prev.cf.Position else k1.cf.Position
		local p3 = if nextKey and k2.ease ~= "cut" then nextKey.cf.Position else k2.cf.Position
		pos = catmull(p0, k1.cf.Position, k2.cf.Position, p3, a)
	else
		pos = k1.cf.Position:Lerp(k2.cf.Position, a)
	end
	local rot = k1.cf.Rotation:Lerp(k2.cf.Rotation, a)
	return CFrame.new(pos) * rot, k1.fov + (k2.fov - k1.fov) * a
end

return CameraTrack
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Codec</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Compact text format for recordings: JSON header, "\n", then frames.
-- Frame = root CFrame + Motor6D.Transform per part, 6 numbers each (pos + XYZ euler).
local HttpService = game:GetService("HttpService")

local Codec = {}

Codec.VERSION = 2
Codec.CHUNK_SIZE = 100000

-- Headers are made pure ASCII ("~" marker + %XX escapes) so plugin settings and messages
-- never have to carry non-ASCII text such as Cyrillic names.
local function asciiEscape(s: string): string
	return (string.gsub(s, "[%%\128-\255]", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

local function asciiUnescape(s: string): string
	return (string.gsub(s, "%%(%x%x)", function(h)
		return string.char(tonumber(h, 16) :: number)
	end))
end

local function fmt(n: number, pattern: string): string
	if n ~= n then
		return "0"
	end
	local s = string.format(pattern, n)
	if string.find(s, ".", 1, true) then
		s = (string.gsub(s, "0+$", ""))
		s = (string.gsub(s, "%.$", ""))
	end
	if s == "-0" or s == "" then
		return "0"
	end
	return s
end

local function pushCFrame(out: { string }, cf: CFrame)
	local p = cf.Position
	local rx, ry, rz = cf:ToEulerAnglesXYZ()
	table.insert(out, fmt(p.X, "%.3f"))
	table.insert(out, fmt(p.Y, "%.3f"))
	table.insert(out, fmt(p.Z, "%.3f"))
	table.insert(out, fmt(rx, "%.4f"))
	table.insert(out, fmt(ry, "%.4f"))
	table.insert(out, fmt(rz, "%.4f"))
end

function Codec.cframeToArray(cf: CFrame): { number }
	local p = cf.Position
	local rx, ry, rz = cf:ToEulerAnglesXYZ()
	return { p.X, p.Y, p.Z, rx, ry, rz }
end

function Codec.arrayToCFrame(a: { number }, i: number?): CFrame
	local b = i or 1
	return CFrame.new(a[b] or 0, a[b + 1] or 0, a[b + 2] or 0)
		* CFrame.fromEulerAnglesXYZ(a[b + 3] or 0, a[b + 4] or 0, a[b + 5] or 0)
end

function Codec.newId(): string
	local guid = string.gsub(HttpService:GenerateGUID(false), "-", "")
	return string.lower(string.sub(guid, 1, 12))
end

function Codec.computeLength(rec)
	rec.length = math.max(0, (#rec.frames - 1) / rec.fps)
	return rec.length
end

function Codec.encodeRecording(rec): string
	local header = {
		v = Codec.VERSION,
		id = rec.id,
		name = rec.name,
		fps = rec.fps,
		rig = rec.rig,
		userId = rec.userId,
		desc = rec.desc,
		parts = rec.parts,
		offset = rec.offset,
		target = rec.target,
	}
	local out = table.create(#rec.frames)
	local nums = {}
	for i, frame in rec.frames do
		table.clear(nums)
		pushCFrame(nums, frame.root)
		for j = 1, #rec.parts do
			pushCFrame(nums, frame.joints[j] or CFrame.identity)
		end
		out[i] = table.concat(nums, ",")
	end
	return "~" .. asciiEscape(HttpService:JSONEncode(header)) .. "\n" .. table.concat(out, ";")
end

function Codec.decodeRecording(str: string)
	if type(str) ~= "string" or str == "" then
		return nil
	end
	local nl = string.find(str, "\n", 1, true)
	local headerStr = if nl then string.sub(str, 1, nl - 1) else str
	local body = if nl then string.sub(str, nl + 1) else ""
	if string.sub(headerStr, 1, 1) == "~" then
		headerStr = asciiUnescape(string.sub(headerStr, 2))
	end
	local ok, header = pcall(function()
		return HttpService:JSONDecode(headerStr)
	end)
	if not ok or type(header) ~= "table" then
		return nil
	end
	local parts = if type(header.parts) == "table" then header.parts else {}
	local frames = {}
	local nums = {}
	for frameStr in string.gmatch(body, "[^;]+") do
		table.clear(nums)
		local k = 0
		for numStr in string.gmatch(frameStr, "[^,]+") do
			k += 1
			nums[k] = tonumber(numStr) or 0
		end
		if k >= 6 then
			local joints = table.create(#parts)
			for j = 1, #parts do
				local base = 6 * j + 1
				joints[j] = if base + 5 <= k then Codec.arrayToCFrame(nums, base) else CFrame.identity
			end
			table.insert(frames, { root = Codec.arrayToCFrame(nums, 1), joints = joints })
		end
	end
	local rec = {
		id = header.id or Codec.newId(),
		name = header.name or "Запись",
		fps = math.max(1, tonumber(header.fps) or 30),
		rig = header.rig or "R15",
		userId = tonumber(header.userId) or 0,
		desc = header.desc,
		parts = parts,
		offset = tonumber(header.offset) or 0,
		target = header.target,
		frames = frames,
	}
	Codec.computeLength(rec)
	return rec
end

-- Returns interpolated root CFrame and joint transforms at time t (seconds from clip start).
function Codec.sample(rec, t: number): (CFrame?, { CFrame }?)
	local frames = rec.frames
	local n = #frames
	if n == 0 then
		return nil, nil
	end
	if n == 1 then
		return frames[1].root, frames[1].joints
	end
	local f = math.clamp(t, 0, rec.length) * rec.fps
	local i = math.floor(f)
	local a = f - i
	local f1 = frames[math.min(i + 1, n)]
	local f2 = frames[math.min(i + 2, n)]
	if a < 1e-4 or f1 == f2 then
		return f1.root, f1.joints
	end
	local joints = table.create(#f1.joints)
	for j, cf in f1.joints do
		joints[j] = cf:Lerp(f2.joints[j] or cf, a)
	end
	return f1.root:Lerp(f2.root, a), joints
end

-- Copy of rec keeping only frames between t0 and t1 (seconds).
function Codec.trim(rec, t0: number, t1: number)
	local n = #rec.frames
	local first = math.clamp(math.floor(t0 * rec.fps + 0.5) + 1, 1, n)
	local last = math.clamp(math.floor(t1 * rec.fps + 0.5) + 1, first, n)
	local copy = table.clone(rec)
	copy.frames = table.move(rec.frames, first, last, 1, {})
	Codec.computeLength(copy)
	return copy
end

function Codec.writeChunks(folder: Instance, str: string)
	for _, child in folder:GetChildren() do
		if child:IsA("StringValue") then
			child:Destroy()
		end
	end
	local size = Codec.CHUNK_SIZE
	local index = 0
	local pos = 1
	local len = #str
	repeat
		local stop = math.min(pos + size - 1, len)
		-- never split a multi-byte UTF-8 character between chunks
		while stop < len and stop > pos do
			local nextByte = string.byte(str, stop + 1)
			if nextByte >= 0x80 and nextByte < 0xC0 then
				stop -= 1
			else
				break
			end
		end
		index += 1
		local value = Instance.new("StringValue")
		value.Name = tostring(index)
		value.Value = string.sub(str, pos, stop)
		value.Parent = folder
		pos = stop + 1
	until pos > len
end

function Codec.readChunks(folder: Instance): string
	local list = {}
	for _, child in folder:GetChildren() do
		if child:IsA("StringValue") then
			table.insert(list, child)
		end
	end
	table.sort(list, function(a, b)
		return (tonumber(a.Name) or 0) < (tonumber(b.Name) or 0)
	end)
	local pieces = table.create(#list)
	for i, child in list do
		pieces[i] = child.Value
	end
	return table.concat(pieces)
end

return Codec
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Log</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Small event log shown in the plugin and mirrored to Output.
local Log = {}

local MAX = 60
Log.entries = {}
Log.listeners = {}

local function push(level: string, text: string)
	table.insert(Log.entries, { time = os.time(), level = level, text = text })
	if #Log.entries > MAX then
		table.remove(Log.entries, 1)
	end
	if level == "error" or level == "warn" then
		warn("[BBS Studio] " .. text)
	else
		print("[BBS Studio] " .. text)
	end
	for _, fn in Log.listeners do
		task.spawn(fn)
	end
end

function Log.info(text: string)
	push("info", text)
end

function Log.warn(text: string)
	push("warn", text)
end

function Log.error(text: string)
	push("error", text)
end

function Log.onChanged(fn: () -> ())
	table.insert(Log.listeners, fn)
end

return Log
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Playback</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Drives puppets (and optionally the camera) from scene data. Used by the plugin in edit mode,
-- by the plugin inside a playtest, and by the in-game player.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Codec = require(script.Parent.Codec)
local CameraTrack = require(script.Parent.CameraTrack)
local Rig = require(script.Parent.Rig)
local SceneData = require(script.Parent.SceneData)

local Playback = {}
Playback.__index = Playback

-- opts.folderName: puppet folder name; opts.parent: () -> Instance, where the folder lives.
function Playback.new(opts)
	opts = opts or {}
	local self = setmetatable({}, Playback)
	self.folderName = opts.folderName or "BBS_Puppets"
	self.getParent = opts.parent or function()
		return Workspace
	end
	self.puppets = {}
	self.exclude = {}
	self.time = 0
	self.playing = false
	self.loop = false
	self.useCamera = false
	self.onTime = nil
	self.onStopped = nil
	self.onError = nil
	self.errored = {}
	return self
end

function Playback:getPuppetFolder(): Folder
	local parent = self.getParent()
	local f = self.puppetFolder
	if f and f.Parent == parent then
		return f
	end
	if f then
		f:Destroy()
	end
	f = parent:FindFirstChild(self.folderName)
	if not f then
		f = Instance.new("Folder")
		f.Name = self.folderName
		-- puppets are regenerated from data: never saved with the place or copied into playtests
		f.Archivable = false
		f.Parent = parent
	end
	self.puppetFolder = f
	return f
end

function Playback:clearPuppet(state)
	if state.model then
		state.model:Destroy()
	end
	state.model = nil
	state.rig = nil
	state.skin = nil
end

function Playback:refresh()
	local root = SceneData.getRoot(false)
	local alive = {}
	if root then
		for _, actor in SceneData.listActors(root) do
			alive[actor] = true
			if not self.puppets[actor] then
				self.puppets[actor] = {}
			end
		end
	end
	for actor, state in self.puppets do
		if not alive[actor] then
			self:clearPuppet(state)
			self.puppets[actor] = nil
		end
	end
	local folder = self.puppetFolder
	if folder and folder.Parent then
		local tracked = {}
		for _, state in self.puppets do
			if state.model then
				tracked[state.model] = true
			end
		end
		for _, child in folder:GetChildren() do
			if not tracked[child] then
				child:Destroy()
			end
		end
	end
end

function Playback:invalidate(actor: Instance?)
	if actor then
		local state = self.puppets[actor]
		if state then
			self:clearPuppet(state)
		end
		self.errored[actor] = nil
	else
		for _, state in self.puppets do
			self:clearPuppet(state)
		end
		self.errored = {}
	end
end

function Playback:getPuppet(actor: Instance): Model?
	local state = self.puppets[actor]
	return state and state.model
end

function Playback:ensureSkin(actor: Instance, state, skinName: string?): Model?
	if state.skin == skinName and state.model and state.model.Parent then
		return state.model
	end
	self:clearPuppet(state)
	state.skin = skinName
	if not skinName or skinName == SceneData.HIDDEN_SKIN then
		return nil
	end
	local source = SceneData.getSkin(actor, skinName)
	if not source then
		return nil
	end
	local wasArchivable = source.Archivable
	source.Archivable = true
	local model = source:Clone()
	source.Archivable = wasArchivable
	if not model then
		return nil
	end
	model.Name = SceneData.getName(actor)
	model:SetAttribute("BBS_ActorId", actor.Name)
	local rig = Rig.prepare(model)
	if not rig then
		model:Destroy()
		error("в скине «" .. skinName .. "» нет ни одной детали (BasePart)", 0)
	end
	state.rig = rig
	model.Parent = self:getPuppetFolder()
	state.model = model
	return model
end

-- Root CFrame of an actor at scene time t, straight from the recording.
function Playback.actorRootAt(actor: Instance, t: number): CFrame?
	local rec = SceneData.getRecording(actor)
	if not rec then
		return nil
	end
	local rel = t - (tonumber(actor:GetAttribute("Offset")) or 0)
	return (Codec.sample(rec, rel))
end

function Playback:evaluateActor(actor: Instance, state, t: number)
	local enabled = actor:GetAttribute("Enabled") ~= false and not self.exclude[actor.Name]
	local rel = t - (tonumber(actor:GetAttribute("Offset")) or 0)
	local skin = if enabled then SceneData.skinAt(actor, rel) else nil
	local model = self:ensureSkin(actor, state, skin)
	if not model then
		return
	end
	local rec = SceneData.getRecording(actor)
	if not rec then
		return
	end
	local rootCf, joints = Codec.sample(rec, rel)
	if rootCf then
		Rig.apply(state.rig, rec.parts, rootCf, joints)
	end
end

function Playback:evaluate(t: number)
	self.time = t
	local root = SceneData.getRoot(false)
	if root then
		for actor, state in self.puppets do
			if actor.Parent then
				local ok, err = pcall(self.evaluateActor, self, actor, state, t)
				if not ok and not self.errored[actor] then
					-- report once per actor, not every frame
					self.errored[actor] = true
					local text = SceneData.getName(actor) .. ": " .. tostring(err)
					if self.onError then
						self.onError(text)
					else
						warn("[BBS Studio] " .. text)
					end
				end
			end
		end
		if self.useCamera then
			local cf, fov = CameraTrack.evaluate(SceneData.getCamera(root), t)
			local cam = Workspace.CurrentCamera
			if cf and cam then
				cam.CFrame = cf
				cam.Focus = cf * CFrame.new(0, 0, -10)
				cam.FieldOfView = fov
			end
		end
	end
	if self.onTime then
		self.onTime(t)
	end
end

function Playback:length(): number
	local root = SceneData.getRoot(false)
	return if root then SceneData.sceneLength(root) else 0
end

function Playback:play(from: number?)
	if from then
		self.time = from
	end
	if self.time >= self:length() - 1e-3 then
		self.time = 0
	end
	self:pause()
	self.playing = true
	local signal = if RunService:IsRunning() and RunService:IsClient()
		then RunService.RenderStepped
		else RunService.Heartbeat
	self.conn = signal:Connect(function(dt)
		local t = self.time + dt
		local len = self:length()
		if t >= len then
			if self.loop then
				t = 0
			else
				self:evaluate(len)
				self:pause()
				if self.onStopped then
					self.onStopped()
				end
				return
			end
		end
		self:evaluate(t)
	end)
end

function Playback:pause()
	self.playing = false
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
end

function Playback:destroy()
	self:pause()
	for _, state in self.puppets do
		self:clearPuppet(state)
	end
	self.puppets = {}
	if self.puppetFolder then
		self.puppetFolder:Destroy()
	end
	self.puppetFolder = nil
end

return Playback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Rig</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Puppets: every part is anchored, joints are disabled and part CFrames are computed here
-- (forward kinematics over the joint tree). Motor6D.Transform is only applied by the physics
-- step, which never runs in edit mode, so poses must not rely on the engine solving joints.
local Workspace = game:GetService("Workspace")

local Rig = {}

local function insideAccessory(inst: Instance, model: Instance): boolean
	local p = inst.Parent
	while p and p ~= model do
		if p:IsA("Accoutrement") or p:IsA("Tool") then
			return true
		end
		p = p.Parent
	end
	return false
end

-- Body joints used for recording, keyed by Part1 name.
function Rig.getJoints(model: Instance): { [string]: Motor6D }
	local map = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Part1 and not insideAccessory(d, model) then
			map[d.Part1.Name] = d
		end
	end
	return map
end

function Rig.findRoot(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

function Rig.getRootCFrame(model: Model): CFrame
	local root = Rig.findRoot(model)
	return if root then root.CFrame else model:GetPivot()
end

-- Removes scripts so stored skins and puppets never run code (and stay replicable in Team Create).
function Rig.sanitize(model: Instance)
	for _, d in model:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
end

local function jointParts(j: Instance): (BasePart?, BasePart?)
	local p0, p1
	if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
		p0, p1 = (j :: any).Part0, (j :: any).Part1
	elseif j:IsA("RigidConstraint") then
		local a0, a1 = j.Attachment0, j.Attachment1
		p0 = a0 and a0.Parent
		p1 = a1 and a1.Parent
	end
	if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") then
		return p0, p1
	end
	return nil, nil
end

-- Offset of `child` relative to `parent` for a rigid joint, from the joint's own data when possible.
local function rigidOffset(j: Instance, parent: BasePart, child: BasePart): CFrame
	if j:IsA("JointInstance") then
		local c0, c1 = (j :: any).C0, (j :: any).C1
		if (j :: any).Part0 == parent then
			return c0 * c1:Inverse()
		end
		return c1 * c0:Inverse()
	elseif j:IsA("RigidConstraint") then
		local a0, a1 = j.Attachment0, j.Attachment1
		if a0.Parent == parent then
			return a0.CFrame * a1.CFrame:Inverse()
		end
		return a1.CFrame * a0.CFrame:Inverse()
	end
	return parent.CFrame:ToObjectSpace(child.CFrame)
end

-- Turns a cloned skin into a puppet and returns its kinematic description.
function Rig.prepare(model: Model)
	Rig.sanitize(model)
	for _, d in model:GetDescendants() do
		if d:IsA("Animator") then
			d:Destroy()
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			humanoid.BreakJointsOnDeath = false
			humanoid.RequiresNeck = false
			humanoid.EvaluateStateMachine = false
		end)
	end
	local root = Rig.findRoot(model)
	if not root then
		return nil
	end
	model.PrimaryPart = root

	local parts = {}
	local inModel = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			inModel[d] = true
		end
	end

	local edges = {}
	local joints = {}
	for _, d in model:GetDescendants() do
		local p0, p1 = jointParts(d)
		if p0 and inModel[p0] and inModel[p1] then
			table.insert(joints, d)
			edges[p0] = edges[p0] or {}
			edges[p1] = edges[p1] or {}
			table.insert(edges[p0], { other = p1, joint = d })
			table.insert(edges[p1], { other = p0, joint = d })
		end
	end

	-- breadth-first from the root so every parent is solved before its children
	local nodes = {}
	local visited = { [root] = true }
	local queue = { root }
	local head = 1
	while head <= #queue do
		local current = queue[head]
		head += 1
		for _, edge in edges[current] or {} do
			local other, j = edge.other, edge.joint
			if not visited[other] then
				visited[other] = true
				table.insert(queue, other)
				local node = { part = other, parent = current }
				if j:IsA("Motor6D") and not insideAccessory(j, model) then
					node.motor = true
					node.name = j.Part1.Name
					node.invert = j.Part0 ~= current
					node.c0 = j.C0
					node.c1 = j.C1
				else
					node.offset = rigidOffset(j, current, other)
				end
				table.insert(nodes, node)
			end
		end
	end
	for _, part in parts do
		if not visited[part] then
			table.insert(nodes, { part = part, parent = root, offset = root.CFrame:ToObjectSpace(part.CFrame) })
		end
	end

	for _, j in joints do
		pcall(function()
			(j :: any).Enabled = false
		end)
	end
	for _, part in parts do
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
	end

	local partList = { root }
	for i, node in nodes do
		partList[i + 1] = node.part
	end
	return {
		root = root,
		humanoid = humanoid,
		nodes = nodes,
		partList = partList,
		cframes = table.create(#partList),
		solved = {},
		mappedParts = nil,
	}
end

function Rig.apply(info, recParts: { string }, rootCf: CFrame, joints: { CFrame }?)
	if info.mappedParts ~= recParts then
		local index = {}
		for i, name in recParts do
			index[name] = i
		end
		for _, node in info.nodes do
			node.recIndex = if node.motor then index[node.name] else nil
		end
		info.mappedParts = recParts
	end
	local solved = info.solved
	local cframes = info.cframes
	solved[info.root] = rootCf
	cframes[1] = rootCf
	for i, node in info.nodes do
		local parentCf = solved[node.parent] or rootCf
		local cf
		if node.motor then
			local t = (joints and node.recIndex and joints[node.recIndex]) or CFrame.identity
			if node.invert then
				cf = parentCf * node.c1 * t:Inverse() * node.c0:Inverse()
			else
				cf = parentCf * node.c0 * t * node.c1:Inverse()
			end
		else
			cf = parentCf * node.offset
		end
		solved[node.part] = cf
		cframes[i + 1] = cf
	end
	Workspace:BulkMoveTo(info.partList, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

return Rig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RuntimePlayer</string>
          <string name="Source"><![CDATA[--!nonstrict
-- In-game scene player. Installed by the plugin into ReplicatedStorage.BBS_Runtime and started
-- by StarterPlayerScripts.BBS_Player. Settings live as attributes on ReplicatedStorage.BBS_Data.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Playback = require(script.Parent.Playback)
local SceneData = require(script.Parent.SceneData)

local RuntimePlayer = {}

local function setting(name: string, default: any): any
	local root = SceneData.getRoot(false)
	local v = root and root:GetAttribute(name)
	if v == nil then
		return default
	end
	return v
end

local function makeLetterbox(player: Player): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "BBS_Letterbox"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 100
	gui.Enabled = false
	for _, top in { true, false } do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.BackgroundColor3 = Color3.new(0, 0, 0)
		bar.Size = UDim2.fromScale(1, 0.11)
		bar.AnchorPoint = Vector2.new(0, if top then 0 else 1)
		bar.Position = UDim2.fromScale(0, if top then 0 else 1)
		bar.Parent = gui
	end
	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

local function setCharacterHidden(player: Player, hidden: boolean)
	local character = player.Character
	if not character then
		return
	end
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

function RuntimePlayer.start()
	local player = Players.LocalPlayer
	ReplicatedStorage:WaitForChild(SceneData.ROOT_NAME, 10)
	local playback = Playback.new({ folderName = "BBS_LocalPuppets" })
	local letterbox = makeLetterbox(player)
	local active = false
	local savedFov = 70

	local function stop()
		if not active then
			return
		end
		active = false
		playback:destroy()
		RunService:UnbindFromRenderStep("BBS_HidePlayer")
		letterbox.Enabled = false
		setCharacterHidden(player, false)
		local camera = Workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = savedFov
	end

	local function start()
		local root = SceneData.getRoot(false)
		if active or not root then
			return
		end
		active = true
		local camera = Workspace.CurrentCamera
		savedFov = camera.FieldOfView
		local hasCamera = #SceneData.getCamera(root).keys > 0
		playback.useCamera = hasCamera
		if hasCamera then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		playback.loop = setting("Loop", false) == true
		letterbox.Enabled = setting("Letterbox", true) == true
		if setting("HidePlayer", true) == true then
			-- camera scripts reset LocalTransparencyModifier every frame, so re-apply after them
			RunService:BindToRenderStep("BBS_HidePlayer", Enum.RenderPriority.Camera.Value + 1, function()
				setCharacterHidden(player, true)
			end)
		end
		playback:refresh()
		playback:play(0)
	end

	playback.onStopped = stop

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local ok, key = pcall(function()
			return Enum.KeyCode[setting("PlayerKey", "P")]
		end)
		if ok and key and input.KeyCode == key then
			if active then
				stop()
			else
				start()
			end
		end
	end)

	if setting("Autoplay", false) == true then
		task.delay(setting("AutoplayDelay", 2), start)
	end

	return { start = start, stop = stop, playback = playback }
end

return RuntimePlayer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">SceneData</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Scene storage in ReplicatedStorage.BBS_Data, so it is saved with the place and visible to clients:
--   BBS_Data (attrs: Length, PlayerKey, Autoplay, HidePlayer, Letterbox, Loop)
--     Camera: StringValue (JSON keyframes)
--     Actors/<id>: Folder (attrs: DisplayName, Offset, Enabled, DefaultSkin, Color, Order, RecVersion)
--       Recording: Folder of StringValue chunks
--       Skins: Folder of Models
--       SkinKeys: StringValue (JSON [{t, skin}], t relative to the actor's start)
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Codec = require(script.Parent.Codec)
local CameraTrack = require(script.Parent.CameraTrack)
local Rig = require(script.Parent.Rig)

local SceneData = {}

SceneData.ROOT_NAME = "BBS_Data"
SceneData.HIDDEN_SKIN = "-"

local PALETTE = {
	Color3.fromRGB(88, 140, 255),
	Color3.fromRGB(255, 140, 70),
	Color3.fromRGB(90, 200, 120),
	Color3.fromRGB(220, 90, 200),
	Color3.fromRGB(240, 200, 70),
	Color3.fromRGB(80, 200, 220),
	Color3.fromRGB(230, 90, 90),
}

local recCache = setmetatable({}, { __mode = "k" })
local cameraCache = setmetatable({}, { __mode = "k" })
local keysCache = setmetatable({}, { __mode = "k" })

function SceneData.getRoot(create: boolean?): Folder?
	local root = ReplicatedStorage:FindFirstChild(SceneData.ROOT_NAME)
	if not root and create then
		root = Instance.new("Folder")
		root.Name = SceneData.ROOT_NAME
		root:SetAttribute("Length", 0)
		root:SetAttribute("PlayerKey", "P")
		root:SetAttribute("Autoplay", false)
		root:SetAttribute("HidePlayer", true)
		root:SetAttribute("Letterbox", true)
		root:SetAttribute("Loop", false)
		local actors = Instance.new("Folder")
		actors.Name = "Actors"
		actors.Parent = root
		local cam = Instance.new("StringValue")
		cam.Name = "Camera"
		cam.Value = CameraTrack.encode(CameraTrack.new())
		cam.Parent = root
		root.Parent = ReplicatedStorage
	end
	return root
end

function SceneData.getActorsFolder(root: Instance): Folder
	local f = root:FindFirstChild("Actors")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Actors"
		f.Parent = root
	end
	return f
end

function SceneData.listActors(root: Instance): { Folder }
	local f = root:FindFirstChild("Actors")
	local list = {}
	if not f then
		return list
	end
	for _, child in f:GetChildren() do
		if child:IsA("Folder") then
			table.insert(list, child)
		end
	end
	table.sort(list, function(a, b)
		local oa, ob = a:GetAttribute("Order") or 0, b:GetAttribute("Order") or 0
		if oa == ob then
			return a.Name < b.Name
		end
		return oa < ob
	end)
	return list
end

function SceneData.findActor(root: Instance, id: string): Folder?
	local f = root:FindFirstChild("Actors")
	local actor = f and f:FindFirstChild(id)
	return if actor and actor:IsA("Folder") then actor else nil
end

function SceneData.getName(actor: Instance): string
	local name = actor:GetAttribute("DisplayName")
	return if type(name) == "string" then name else actor.Name
end

-- Recording ----------------------------------------------------------------

function SceneData.getRecording(actor: Instance)
	local folder = actor:FindFirstChild("Recording")
	if not folder then
		return nil
	end
	local version = actor:GetAttribute("RecVersion") or 0
	local cached = recCache[actor]
	if cached and cached.version == version then
		return cached.rec
	end
	local rec = Codec.decodeRecording(Codec.readChunks(folder))
	recCache[actor] = { version = version, rec = rec }
	return rec
end

function SceneData.setRecording(actor: Instance, rec)
	local folder = actor:FindFirstChild("Recording")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Recording"
		folder.Parent = actor
	end
	Codec.writeChunks(folder, Codec.encodeRecording(rec))
	local version = (tonumber(actor:GetAttribute("RecVersion")) or 0) + 1
	actor:SetAttribute("RecVersion", version)
	actor:SetAttribute("RecordingId", rec.id)
	recCache[actor] = { version = version, rec = rec }
end

function SceneData.actorLength(actor: Instance): number
	local rec = SceneData.getRecording(actor)
	return if rec then rec.length else 0
end

-- Skins --------------------------------------------------------------------

function SceneData.getSkinsFolder(actor: Instance): Folder
	local f = actor:FindFirstChild("Skins")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Skins"
		f.Parent = actor
	end
	return f
end

function SceneData.listSkins(actor: Instance): { Model }
	local list = {}
	local f = actor:FindFirstChild("Skins")
	if f then
		for _, child in f:GetChildren() do
			if child:IsA("Model") then
				table.insert(list, child)
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Name < b.Name
	end)
	return list
end

function SceneData.getSkin(actor: Instance, name: string): Model?
	local f = actor:FindFirstChild("Skins")
	local m = f and f:FindFirstChild(name)
	return if m and m:IsA("Model") then m else nil
end

-- Adds a model as a skin under a unique name and returns that name.
function SceneData.addSkin(actor: Instance, model: Model, name: string?): string
	local folder = SceneData.getSkinsFolder(actor)
	local base = name or model.Name
	if base == "" or base == SceneData.HIDDEN_SKIN then
		base = "Скин"
	end
	local unique = base
	local n = 1
	while folder:FindFirstChild(unique) do
		n += 1
		unique = base .. " " .. n
	end
	model.Name = unique
	model.Archivable = true
	Rig.sanitize(model)
	model.Parent = folder
	local default = actor:GetAttribute("DefaultSkin")
	if not default or not SceneData.getSkin(actor, default) then
		actor:SetAttribute("DefaultSkin", unique)
	end
	return unique
end

function SceneData.getSkinKeys(actor: Instance): { { t: number, skin: string } }
	local sv = actor:FindFirstChild("SkinKeys")
	if not sv or not sv:IsA("StringValue") then
		return {}
	end
	local cached = keysCache[actor]
	if cached and cached.value == sv.Value then
		return cached.keys
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(sv.Value)
	end)
	local keys = {}
	if ok and type(data) == "table" then
		for _, k in data do
			if type(k) == "table" and type(k.skin) == "string" then
				table.insert(keys, { t = tonumber(k.t) or 0, skin = k.skin })
			end
		end
	end
	table.sort(keys, function(a, b)
		return a.t < b.t
	end)
	keysCache[actor] = { value = sv.Value, keys = keys }
	return keys
end

function SceneData.setSkinKeys(actor: Instance, keys)
	local sv = actor:FindFirstChild("SkinKeys")
	if not sv then
		sv = Instance.new("StringValue")
		sv.Name = "SkinKeys"
		sv.Parent = actor
	end
	local sorted = table.clone(keys)
	table.sort(sorted, function(a, b)
		return a.t < b.t
	end)
	sv.Value = HttpService:JSONEncode(sorted)
end

function SceneData.skinAt(actor: Instance, rel: number): string?
	local skin = actor:GetAttribute("DefaultSkin")
	for _, k in SceneData.getSkinKeys(actor) do
		if k.t <= rel + 1e-6 then
			skin = k.skin
		else
			break
		end
	end
	return skin
end

-- Actors -------------------------------------------------------------------

function SceneData.createActor(root: Instance, opts)
	local actorsFolder = SceneData.getActorsFolder(root)
	local existing = SceneData.listActors(root)
	local maxOrder = 0
	for _, a in existing do
		maxOrder = math.max(maxOrder, a:GetAttribute("Order") or 0)
	end
	local actor = Instance.new("Folder")
	actor.Name = Codec.newId()
	actor:SetAttribute("DisplayName", opts.name or ("Актёр " .. (#existing + 1)))
	actor:SetAttribute("Offset", opts.offset or 0)
	actor:SetAttribute("Enabled", true)
	actor:SetAttribute("Order", maxOrder + 1)
	actor:SetAttribute("Color", PALETTE[(#existing % #PALETTE) + 1])
	SceneData.getSkinsFolder(actor)
	SceneData.setSkinKeys(actor, {})
	if opts.skin then
		SceneData.addSkin(actor, opts.skin)
	end
	if opts.rec then
		SceneData.setRecording(actor, opts.rec)
	end
	actor.Parent = actorsFolder
	return actor
end

-- Camera -------------------------------------------------------------------

function SceneData.getCamera(root: Instance)
	local sv = root:FindFirstChild("Camera")
	local value = if sv and sv:IsA("StringValue") then sv.Value else ""
	local cached = cameraCache[root]
	if cached and cached.value == value then
		return cached.track
	end
	local track = CameraTrack.decode(value)
	cameraCache[root] = { value = value, track = track }
	return track
end

function SceneData.setCamera(root: Instance, track)
	local sv = root:FindFirstChild("Camera")
	if not sv then
		sv = Instance.new("StringValue")
		sv.Name = "Camera"
		sv.Parent = root
	end
	CameraTrack.sort(track)
	sv.Value = CameraTrack.encode(track)
end

-- Returns an editable deep copy of the camera track.
function SceneData.copyCamera(root: Instance)
	local src = SceneData.getCamera(root)
	local copy = { interp = src.interp, keys = {} }
	for i, k in src.keys do
		copy.keys[i] = table.clone(k)
	end
	return copy
end

-- Length -------------------------------------------------------------------

function SceneData.autoLength(root: Instance): number
	local len = 1
	for _, actor in SceneData.listActors(root) do
		len = math.max(len, (actor:GetAttribute("Offset") or 0) + SceneData.actorLength(actor))
	end
	local keys = SceneData.getCamera(root).keys
	if #keys > 0 then
		len = math.max(len, keys[#keys].t)
	end
	return len
end

function SceneData.sceneLength(root: Instance): number
	local fixed = root:GetAttribute("Length")
	if type(fixed) == "number" and fixed > 0 then
		return fixed
	end
	return SceneData.autoLength(root)
end

return SceneData
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>