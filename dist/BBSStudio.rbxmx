  <Item class="Script" referent="0">
    <Properties>
      <string name="Name">BBSStudio</string>
      <token name="RunContext">0</token>
      <string name="Source"><![CDATA[--!nonstrict
-- BBS Studio: machinima toolkit inspired by the BBS / Blockbuster mod for Minecraft.
-- Studio runs a copy of every plugin in the edit DataModel and in each playtest DataModel.
local RunService = game:GetService("RunService")

local PluginFolder = script:WaitForChild("Plugin")

local mode = if not RunService:IsRunning() then "edit" elseif RunService:IsClient() then "play" else nil

if mode then
	local ok, err = xpcall(function()
		if mode == "edit" then
			require(PluginFolder.App).start(plugin)
		else
			require(PluginFolder.PlayApp).start(plugin)
		end
	end, debug.traceback)
	if ok then
		if mode == "edit" then
			print("[BBS Studio] плагин загружен — кнопка «BBS Studio» на вкладке Plugins")
		end
	else
		warn("[BBS Studio] ошибка запуска плагина:\n" .. tostring(err))
	end
end
]]></string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Plugin</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">App</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Edit-mode window: transport, timeline, actors, skins, camera, recordings and the in-game player.
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Shared = script.Parent.Parent.Shared
local Codec = require(Shared.Codec)
local CameraTrack = require(Shared.CameraTrack)
local Rig = require(Shared.Rig)
local SceneData = require(Shared.SceneData)
local Playback = require(Shared.Playback)
local Log = require(Shared.Log)

local UI = require(script.Parent.UI)
local Timeline = require(script.Parent.Timeline)
local History = require(script.Parent.History)
local Appearance = require(script.Parent.Appearance)
local Bridge = require(script.Parent.Bridge)
local Version = require(script.Parent.Version)

local C = UI.C
local GAP = 6
local TOP_H = 28
local TABS_H = 26
local STATUS_H = 18

local RUNTIME_FOLDER = "BBS_Runtime"
local RUNTIME_SCRIPT = "BBS_Player"
local RUNTIME_SOURCE = [[
-- Generated by BBS Studio: plays the BBS scene in game (key and options: ReplicatedStorage.BBS_Data attributes).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
require(ReplicatedStorage:WaitForChild("BBS_Runtime"):WaitForChild("RuntimePlayer")).start()
]]

local SETTING_FPS = "BBS_RecordFPS"
local SETTING_COUNTDOWN = "BBS_RecordCountdown"
local SETTING_FROM_CURSOR = "BBS_RecordFromCursor"
local AUTO_IMPORT_MAX_AGE = 6 * 3600

local TABS = {
	{ id = "actors", label = "Актёры" },
	{ id = "camera", label = "Камера" },
	{ id = "record", label = "Запись" },
	{ id = "scene", label = "Сцена" },
}

local App = {}
App.__index = App

-- Selected model, climbing to the outermost Model so clicking a limb selects the character.
local function selectedModel(): Model?
	for _, obj in Selection:Get() do
		local model = if obj:IsA("Model") then obj else obj:FindFirstAncestorOfClass("Model")
		while model and model.Parent and model.Parent:IsA("Model") do
			model = model.Parent
		end
		if model then
			return model
		end
	end
	return nil
end

local function cloneModel(model: Model): Model
	local was = model.Archivable
	model.Archivable = true
	local copy = model:Clone()
	model.Archivable = was
	return copy
end

function App.start(plugin: Plugin)
	local self = setmetatable({}, App)
	self.plugin = plugin
	self.alive = true
	self.tab = "actors"
	self.selected = nil
	self.selectedKey = nil
	self.importQueue = {}
	self.importing = {}
	self.confirmClear = false
	self.lastPendingCount = -1
	self.connections = {}
	self.bridge = Bridge.new(plugin)
	self.showPath = false
	self.pathKey = nil

	-- Camera children are local to this Studio window: previews are not replicated to Team Create
	-- collaborators and are never saved.
	self.playback = Playback.new({
		folderName = "BBS_Puppets",
		parent = function()
			return Workspace.CurrentCamera
		end,
	})
	self.playback.onTime = function(t)
		self:onTime(t)
	end
	self.playback.onStopped = function()
		self:updateTransport()
	end
	self.playback.onError = function(text)
		Log.error(text)
	end

	local toolbar = plugin:CreateToolbar("BBS Studio")
	self.button = toolbar:CreateButton("BBSStudioOpen", "BBS Studio — съёмка машинимы", "", "BBS Studio")
	self.button.ClickableWhenViewportHidden = true
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 470, 700, 380, 360)
	self.widget = UI.createWidget(plugin, "BBSStudio_Edit", info)
	self.widget.Title = Version.LABEL
	self.widget.Name = "BBSStudio"
	self.widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.button.Click:Connect(function()
		self.widget.Enabled = not self.widget.Enabled
	end)
	self.widget:GetPropertyChangedSignal("Enabled"):Connect(function()
		self.button:SetActive(self.widget.Enabled)
	end)
	self.button:SetActive(self.widget.Enabled)

	self:buildShell()

	local function track(conn)
		table.insert(self.connections, conn)
	end
	track(ChangeHistoryService.OnUndo:Connect(function()
		self:onDataChanged()
	end))
	track(ChangeHistoryService.OnRedo:Connect(function()
		self:onDataChanged()
	end))
	track(Selection.SelectionChanged:Connect(function()
		self:onSelectionChanged()
	end))

	self.bridge:listenFromTests(function(str)
		self:queueImport(str)
	end, function()
		self:onTestsChanged()
	end)
	self:createActions()
	Log.onChanged(function()
		if self.tab == "scene" and self.alive then
			self:render()
		end
	end)

	task.spawn(function()
		while self.alive do
			task.wait(2)
			if not self.alive then
				break
			end
			if not self.bridge:hasActiveTests() then
				self:processQueue()
				self:autoImportPending()
			end
			local count = #self.bridge:getPendingIndex() + #self.importQueue
			if count ~= self.lastPendingCount then
				self.lastPendingCount = count
				if self.tab == "record" or self.tab == "actors" then
					self:render()
				end
			end
		end
	end)

	plugin.Unloading:Connect(function()
		self.alive = false
		self.playback:destroy()
		self:clearPath()
		for _, conn in self.connections do
			conn:Disconnect()
		end
	end)

	-- leftovers of v0.1, which kept puppets in Workspace
	local legacy = Workspace:FindFirstChild("BBS_Puppets")
	if legacy and not legacy.Archivable then
		legacy:Destroy()
	end

	if SceneData.getRoot(false) then
		self.playback:refresh()
		self.playback:evaluate(0)
	end
	self:render()
	return self
end

function App:createActions()
	local plugin = self.plugin
	pcall(function()
		plugin:CreatePluginAction("BBSStudio_PlayPause", "BBS: воспроизведение / пауза", "Проиграть сцену BBS Studio", "", true).Triggered
			:Connect(function()
				self:togglePlay()
			end)
		plugin:CreatePluginAction("BBSStudio_CameraKey", "BBS: ключ камеры", "Добавить ключ камеры из текущего вида", "", true).Triggered
			:Connect(function()
				self:addCameraKey()
			end)
		plugin:CreatePluginAction("BBSStudio_ToStart", "BBS: в начало", "Перемотать сцену в начало", "", true).Triggered
			:Connect(function()
				self:pausePlayback()
				self:seek(0)
			end)
	end)
end

-- Layout ---------------------------------------------------------------------

function App:buildShell()
	local rootFrame = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.bg,
		BorderSizePixel = 0,
		Parent = self.widget,
	})
	self.rootFrame = rootFrame

	local top = UI.row({}, { Parent = rootFrame })
	self.topBar = top
	UI.button("|◀", function()
		self:pausePlayback()
		self:seek(0)
	end, { Parent = top })
	self.btnPlay = UI.button("▶", function()
		self:togglePlay()
	end, {
		Parent = top,
		BackgroundColor3 = C.accent,
		AutomaticSize = Enum.AutomaticSize.None,
		Size = UDim2.fromOffset(40, 24),
	})
	UI.button("■", function()
		self:pausePlayback()
		self:seek(0)
	end, { Parent = top })
	self.timeLabel = UI.label("0:00.00 / 0:00.00", {
		Font = UI.FONT_BOLD,
		Size = UDim2.fromOffset(120, 24),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = top,
	})
	self.camToggle = UI.toggle("Камера", false, function(v)
		self:setUseCamera(v)
	end, { Parent = top })
	UI.toggle("Петля", false, function(v)
		self.playback.loop = v
	end, { Parent = top })

	self.timeline = Timeline.new(self, rootFrame)
	self.timeline.onHeightChanged = function()
		self:layout()
	end

	self.tabsRow = UI.row({}, { Parent = rootFrame })
	self.tabButtons = {}
	for _, tab in TABS do
		self.tabButtons[tab.id] = UI.button(tab.label, function()
			self:setTab(tab.id)
		end, { Parent = self.tabsRow })
	end

	self.content = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = rootFrame,
	})
	UI.list(self.content, false, 6)
	UI.pad(self.content, 0, 10, 0, 8)

	self.statusLabel = UI.label("", {
		TextColor3 = C.dim,
		TextSize = 12,
		Parent = rootFrame,
	})

	self.dragOverlay = UI.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1000,
		Visible = false,
		Parent = rootFrame,
	})
	self:layout()
end

function App:layout()
	local y = GAP
	self.topBar.Position = UDim2.fromOffset(GAP, y)
	self.topBar.Size = UDim2.new(1, -2 * GAP, 0, TOP_H)
	y += TOP_H + GAP
	self.timeline.frame.Position = UDim2.fromOffset(GAP, y)
	self.timeline.frame.Size = UDim2.new(1, -2 * GAP, 0, self.timeline.height)
	y += self.timeline.height + GAP
	self.tabsRow.Position = UDim2.fromOffset(GAP, y)
	self.tabsRow.Size = UDim2.new(1, -2 * GAP, 0, TABS_H)
	y += TABS_H + GAP
	self.content.Position = UDim2.fromOffset(GAP, y)
	self.content.Size = UDim2.new(1, -GAP, 1, -y - STATUS_H - GAP)
	self.statusLabel.Position = UDim2.new(0, GAP + 2, 1, -STATUS_H - 2)
	self.statusLabel.Size = UDim2.new(1, -2 * GAP, 0, STATUS_H)
end

function App:toast(text: string, color: Color3?)
	self.statusLabel.Text = text
	self.statusLabel.TextColor3 = color or C.dim
	local token = {}
	self.toastToken = token
	task.delay(6, function()
		if self.toastToken == token then
			self.statusLabel.Text = ""
		end
	end)
end

-- Drag helper: a full-window overlay catches the release wherever the mouse is.
function App:beginDrag(onMove: (Vector2) -> (), onEnd: () -> ())
	local overlay = self.dragOverlay
	overlay.Visible = true
	local finished = false
	local conns = {}
	local function finish()
		if finished then
			return
		end
		finished = true
		for _, c in conns do
			c:Disconnect()
		end
		overlay.Visible = false
		onEnd()
	end
	onMove(self.widget:GetRelativeMousePosition())
	table.insert(
		conns,
		RunService.Heartbeat:Connect(function()
			onMove(self.widget:GetRelativeMousePosition())
		end)
	)
	table.insert(conns, overlay.MouseButton1Up:Connect(finish))
	table.insert(
		conns,
		overlay.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				finish()
			end
		end)
	)
	table.insert(conns, overlay.MouseLeave:Connect(finish))
end

-- State ----------------------------------------------------------------------

function App:setTab(id: string)
	self.tab = id
	self:render()
end

function App:selectActor(actor: Instance?, skipRender: boolean?)
	self.selected = actor
	if actor then
		self.tab = "actors"
	end
	if not skipRender then
		self:render()
	end
end

function App:mutate(name: string, fn: () -> ())
	History.record("BBS: " .. name, fn)
	self:onDataChanged()
end

function App:onDataChanged()
	if self.selected and not self.selected:IsDescendantOf(ReplicatedStorage) then
		self.selected = nil
	end
	self.playback:refresh()
	self.playback:evaluate(math.min(self.playback.time, self.playback:length()))
	self:render()
end

function App:onTime(t: number)
	self.timeLabel.Text = UI.formatTime(t) .. " / " .. UI.formatTime(self.playback:length())
	self.timeline:updatePlayhead(t)
end

function App:updateTransport()
	self.btnPlay.Text = if self.playback.playing then "❚❚" else "▶"
end

function App:seek(t: number)
	self.playback:evaluate(math.clamp(t, 0, self.playback:length()))
end

function App:pausePlayback()
	self.playback:pause()
	self:updateTransport()
end

function App:togglePlay()
	if self.playback.playing then
		self.playback:pause()
	else
		self.playback:refresh()
		self.playback:play()
	end
	self:updateTransport()
end

function App:setUseCamera(v: boolean)
	self.playback.useCamera = v
	UI.setToggle(self.camToggle, v)
	if v then
		self.playback:evaluate(self.playback.time)
	end
	if self.tab == "camera" then
		self:render()
	end
end

function App:onSelectionChanged()
	local folder = self.playback.puppetFolder
	local root = SceneData.getRoot(false)
	if not folder or not folder.Parent or not root then
		return
	end
	for _, obj in Selection:Get() do
		if obj:IsDescendantOf(folder) then
			local model = obj
			while model.Parent ~= folder do
				model = model.Parent
			end
			local actor = SceneData.findActor(root, model:GetAttribute("BBS_ActorId") or "")
			if actor and (actor ~= self.selected or self.tab ~= "actors") then
				self:selectActor(actor)
			end
			return
		end
	end
end

-- Rendering ------------------------------------------------------------------

function App:render()
	if not self.alive then
		return
	end
	for id, button in self.tabButtons do
		UI.recolor(button, if id == self.tab then C.accent else C.panel2)
	end
	UI.clear(self.content)
	if self.tab == "actors" then
		self:renderActors()
	elseif self.tab == "camera" then
		self:renderCamera()
	elseif self.tab == "record" then
		self:renderRecord()
	else
		self:renderScene()
	end
	self.timeline:rebuild()
	self:onTime(self.playback.time)
	self:updateTransport()
	self:updatePath()
end

-- Viewport helpers ------------------------------------------------------------

function App:focusActor(actor: Instance)
	local rec = SceneData.getRecording(actor)
	if not rec then
		self:toast("У актёра нет записи", C.warn)
		return
	end
	local offset = tonumber(actor:GetAttribute("Offset")) or 0
	local t = self.playback.time
	if t < offset or t > offset + rec.length then
		self:pausePlayback()
		self:seek(offset)
	end
	local cf = Playback.actorRootAt(actor, self.playback.time)
	if not cf then
		return
	end
	self:setUseCamera(false)
	local pos = cf.Position
	local look = cf.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 1e-3 then
		look = Vector3.new(0, 0, -1)
	end
	local from = pos + look.Unit * 12 + Vector3.new(0, 4, 0)
	local cam = Workspace.CurrentCamera
	cam.CFrame = CFrame.lookAt(from, pos)
	cam.Focus = CFrame.new(pos)
	if not self.playback:getPuppet(actor) then
		local skin = SceneData.skinAt(actor, self.playback.time - offset)
		if not skin or not SceneData.getSkin(actor, skin) then
			self:toast("Камера наведена, но у актёра нет скина в этот момент — добавьте скин", C.warn)
			return
		end
	end
	self:toast("Камера наведена на «" .. SceneData.getName(actor) .. "»", C.good)
end

function App:clearPath()
	local cam = Workspace.CurrentCamera
	local folder = cam and cam:FindFirstChild("BBS_Path")
	if folder then
		folder:Destroy()
	end
	self.pathKey = nil
end

-- Draws the selected actor's root trajectory as a dotted line in the viewport.
function App:updatePath()
	local actor = self.selected
	if not self.showPath or not actor or not actor.Parent then
		self:clearPath()
		return
	end
	local rec = SceneData.getRecording(actor)
	local key = actor.Name .. ":" .. tostring(actor:GetAttribute("RecVersion"))
	if not rec or key == self.pathKey then
		return
	end
	self:clearPath()
	self.pathKey = key
	local folder = Instance.new("Folder")
	folder.Name = "BBS_Path"
	folder.Archivable = false
	local color = actor:GetAttribute("Color") or C.accent
	local step = math.max(1, math.floor(#rec.frames / 200))
	for i = 1, #rec.frames, step do
		local dot = Instance.new("Part")
		dot.Shape = Enum.PartType.Ball
		dot.Size = Vector3.new(0.35, 0.35, 0.35)
		dot.Material = Enum.Material.Neon
		dot.Color = color
		dot.Anchored = true
		dot.CanCollide = false
		dot.CanTouch = false
		dot.CanQuery = false
		dot.CastShadow = false
		dot.CFrame = CFrame.new(rec.frames[i].root.Position)
		dot.Parent = folder
	end
	folder.Parent = Workspace.CurrentCamera
end

function App:autoImportPending()
	local now = os.time()
	local place = Bridge.placeKey()
	for _, entry in self.bridge:getPendingIndex() do
		local fresh = type(entry.time) == "number" and now - entry.time < AUTO_IMPORT_MAX_AGE
		if entry.place == place and fresh and not self.importing[entry.id] then
			local str = self.bridge:loadPending(entry.id)
			if str then
				Log.info("импорт из резервного сохранения: «" .. Bridge.entryName(entry) .. "»")
				local ok, err = pcall(self.importRecordingString, self, str)
				if not ok then
					Log.error("импорт не удался: " .. tostring(err))
					self.bridge:removePending(entry.id)
				end
			else
				self.bridge:removePending(entry.id)
			end
		end
	end
end

-- Actors tab -----------------------------------------------------------------

function App:renderActors()
	local root = SceneData.getRoot(false)
	local sec = UI.section("Актёры", self.content)
	UI.row({
		UI.button("+ Актёр из выделенной модели", function()
			self:addActorFromSelection()
		end),
		UI.button("● Записать игрока…", function()
			self:setTab("record")
		end),
	}, { Parent = sec })

	local waiting = #self.bridge:getPendingIndex() + #self.importQueue
	if waiting > 0 then
		UI.button("Записей ждут импорта: " .. waiting .. " → вкладка «Запись»", function()
			self:setTab("record")
		end, { Parent = sec, BackgroundColor3 = C.warn, TextColor3 = Color3.new(0, 0, 0) })
	end

	local actors = if root then SceneData.listActors(root) else {}
	if #actors == 0 then
		UI.paragraph(
			"Пока нет актёров. Запишите игрока (вкладка «Запись») или выделите модель с Humanoid и нажмите «+ Актёр из выделенной модели».",
			{ Parent = sec }
		)
	end
	for _, actor in actors do
		self:renderActorRow(sec, actor)
	end
	if self.selected and self.selected.Parent then
		self:renderActorDetails(self.selected)
	end
end

function App:renderActorRow(parent: Instance, actor: Instance)
	local isSelected = actor == self.selected
	local row = UI.row({}, {
		Parent = parent,
		BackgroundTransparency = if isSelected then 0 else 1,
		BackgroundColor3 = C.panel2,
	})
	UI.corner(row, 4)
	UI.new("Frame", {
		Size = UDim2.fromOffset(4, 20),
		BackgroundColor3 = actor:GetAttribute("Color") or C.accent,
		BorderSizePixel = 0,
		Parent = row,
	})
	UI.button(if isSelected then "▼" else "▶", function()
		self:selectActor(if isSelected then nil else actor)
	end, { Parent = row, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.fromOffset(26, 24) })
	local nameBox = UI.textbox(SceneData.getName(actor), function(text)
		if text ~= "" and text ~= SceneData.getName(actor) then
			self.playback:invalidate(actor)
			self:mutate("переименование актёра", function()
				actor:SetAttribute("DisplayName", text)
			end)
		end
	end, { Parent = row, Size = UDim2.fromOffset(70, 24) })
	UI.flex(nameBox)
	UI.label("старт", { Parent = row, TextColor3 = C.dim, TextSize = 12, Size = UDim2.fromOffset(32, 24) })
	local function currentOffset(): number
		return tonumber(actor:GetAttribute("Offset")) or 0
	end
	UI.textbox(UI.formatNumber(currentOffset()), function(text, box)
		local v = UI.parseNumber(text)
		if v then
			self:mutate("старт актёра", function()
				actor:SetAttribute("Offset", math.max(0, v))
			end)
		else
			box.Text = UI.formatNumber(currentOffset())
		end
	end, { Parent = row, Size = UDim2.fromOffset(46, 24) })
	UI.toggle("Вкл", actor:GetAttribute("Enabled") ~= false, function(v)
		self:mutate("видимость актёра", function()
			actor:SetAttribute("Enabled", v)
		end)
	end, { Parent = row })
	UI.button("⧉", function()
		self:duplicateActor(actor)
	end, { Parent = row })
	UI.button("◎", function()
		self:focusActor(actor)
	end, { Parent = row })
	UI.button("×", function()
		if self.selected == actor then
			self.selected = nil
		end
		self:mutate("удаление актёра", function()
			actor.Parent = nil
		end)
	end, { Parent = row, BackgroundColor3 = C.danger })
end

function App:renderActorDetails(actor: Instance)
	local rec = SceneData.getRecording(actor)
	local offset = actor:GetAttribute("Offset") or 0
	local sec = UI.section("Актёр: " .. SceneData.getName(actor), self.content)
	if rec then
		local kind = if #rec.parts > 0 then rec.rig else "статичный"
		UI.label(
			string.format("Запись: %.2f с · %d кадров · %d к/с · %s", rec.length, #rec.frames, rec.fps, kind),
			{ Parent = sec, TextColor3 = C.dim, TextSize = 13 }
		)
	end
	UI.row({
		UI.button("Обрезать начало по курсору", function()
			self:trimActor(actor, true)
		end),
		UI.button("Обрезать конец", function()
			self:trimActor(actor, false)
		end),
	}, { Parent = sec })
	UI.row({
		UI.button("Выделить марионетку", function()
			local puppet = self.playback:getPuppet(actor)
			if puppet then
				Selection:Set({ puppet })
			end
		end),
		UI.button("◎ Навести камеру", function()
			self:focusActor(actor)
		end),
		UI.toggle("Траектория", self.showPath, function(v)
			self.showPath = v
			self:updatePath()
		end),
	}, { Parent = sec })

	-- skins
	UI.label("Скины (морфы)", { Parent = sec, Font = UI.FONT_BOLD })
	local default = actor:GetAttribute("DefaultSkin")
	local skins = SceneData.listSkins(actor)
	if #skins == 0 then
		UI.paragraph("Нет скинов — актёр невидим. Добавьте скин ниже.", { Parent = sec, TextColor3 = C.warn })
	end
	for _, skin in skins do
		local isDefault = skin.Name == default
		local row = UI.row({}, { Parent = sec })
		UI.button(if isDefault then "★" else "☆", function()
			if not isDefault then
				self:mutate("скин по умолчанию", function()
					actor:SetAttribute("DefaultSkin", skin.Name)
				end)
			end
		end, {
			Parent = row,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.fromOffset(26, 24),
			TextColor3 = if isDefault then C.warn else C.dim,
		})
		UI.flex(UI.label(skin.Name, { Parent = row, Size = UDim2.fromOffset(60, 24) }))
		UI.button("Сменить на курсоре", function()
			self:addSkinKey(actor, skin.Name)
		end, { Parent = row })
		UI.button("×", function()
			self:removeSkin(actor, skin)
		end, { Parent = row, BackgroundColor3 = C.danger })
	end
	UI.row({
		UI.button("+ Скин из выделенной модели", function()
			self:addSkinFromSelection(actor)
		end),
	}, { Parent = sec })
	local userRow = UI.row({}, { Parent = sec })
	local userBox = UI.textbox("", nil, {
		Parent = userRow,
		PlaceholderText = "UserId или ник игрока",
		Size = UDim2.fromOffset(100, 24),
	})
	UI.flex(userBox)
	UI.button("+ Скин из аватара", function()
		self:addSkinFromUser(actor, userBox.Text)
	end, { Parent = userRow })

	-- skin keys
	UI.label("Смены скина по времени", { Parent = sec, Font = UI.FONT_BOLD })
	local keys = SceneData.getSkinKeys(actor)
	if #keys == 0 then
		UI.paragraph(
			"Поставьте курсор на таймлайне и нажмите «Сменить на курсоре» у нужного скина — актёр переоденется в этот момент.",
			{ Parent = sec }
		)
	end
	for i, key in keys do
		local row = UI.row({}, { Parent = sec })
		local skinText = if key.skin == SceneData.HIDDEN_SKIN then "(скрыт)" else key.skin
		UI.flex(UI.label(UI.formatTime(offset + key.t) .. "  →  " .. skinText, {
			Parent = row,
			Size = UDim2.fromOffset(60, 24),
		}))
		UI.button("Перейти", function()
			self:pausePlayback()
			self:seek(offset + key.t)
		end, { Parent = row })
		UI.button("×", function()
			local copy = table.clone(keys)
			table.remove(copy, i)
			self:mutate("удаление смены скина", function()
				SceneData.setSkinKeys(actor, copy)
			end)
		end, { Parent = row, BackgroundColor3 = C.danger })
	end
	UI.row({
		UI.button("Скрыть актёра с курсора", function()
			self:addSkinKey(actor, SceneData.HIDDEN_SKIN)
		end),
	}, { Parent = sec })
end

function App:addActorFromSelection()
	local model = selectedModel()
	if not model then
		self:toast("Выделите модель (Model) в Workspace", C.warn)
		return
	end
	if model:GetAttribute("BBS_ActorId") then
		self:toast("Это уже марионетка BBS", C.warn)
		return
	end
	local rec = {
		id = Codec.newId(),
		name = model.Name,
		fps = 30,
		rig = "",
		userId = 0,
		parts = {},
		frames = { { root = Rig.getRootCFrame(model), joints = {} } },
	}
	Codec.computeLength(rec)
	self:mutate("новый актёр", function()
		local root = SceneData.getRoot(true)
		-- the model itself becomes the actor's skin (Ctrl+Z puts it back)
		self.selected = SceneData.createActor(root, { name = model.Name, rec = rec, skin = model })
	end)
	self:toast("Модель «" .. model.Name .. "» стала актёром (Ctrl+Z — отменить)", C.good)
end

function App:duplicateActor(actor: Instance)
	self:mutate("дублирование актёра", function()
		local root = SceneData.getRoot(true)
		local maxOrder = 0
		for _, a in SceneData.listActors(root) do
			maxOrder = math.max(maxOrder, a:GetAttribute("Order") or 0)
		end
		local copy = actor:Clone()
		copy.Name = Codec.newId()
		copy:SetAttribute("DisplayName", SceneData.getName(actor) .. " (копия)")
		copy:SetAttribute("Order", maxOrder + 1)
		copy.Parent = actor.Parent
		self.selected = copy
	end)
end

function App:trimActor(actor: Instance, fromStart: boolean)
	local rec = SceneData.getRecording(actor)
	if not rec or #rec.frames < 2 then
		self:toast("У актёра нет движения для обрезки", C.warn)
		return
	end
	local offset = actor:GetAttribute("Offset") or 0
	local rel = self.playback.time - offset
	if rel <= 0 or rel >= rec.length then
		self:toast("Поставьте курсор внутри клипа актёра", C.warn)
		return
	end
	self:mutate("обрезка записи", function()
		if fromStart then
			SceneData.setRecording(actor, Codec.trim(rec, rel, rec.length))
			actor:SetAttribute("Offset", offset + rel)
			local keys = {}
			for _, k in SceneData.getSkinKeys(actor) do
				table.insert(keys, { t = k.t - rel, skin = k.skin })
			end
			SceneData.setSkinKeys(actor, keys)
		else
			SceneData.setRecording(actor, Codec.trim(rec, 0, rel))
		end
	end)
end

function App:addSkinKey(actor: Instance, skinName: string)
	local rel = math.max(0, self.playback.time - (actor:GetAttribute("Offset") or 0))
	local keys = {}
	for _, k in SceneData.getSkinKeys(actor) do
		if math.abs(k.t - rel) > 1e-3 then
			table.insert(keys, k)
		end
	end
	table.insert(keys, { t = rel, skin = skinName })
	self:mutate("смена скина", function()
		SceneData.setSkinKeys(actor, keys)
	end)
end

function App:removeSkin(actor: Instance, skin: Model)
	self.playback:invalidate(actor)
	self:mutate("удаление скина", function()
		local name = skin.Name
		skin.Parent = nil
		if actor:GetAttribute("DefaultSkin") == name then
			local rest = SceneData.listSkins(actor)
			actor:SetAttribute("DefaultSkin", if rest[1] then rest[1].Name else nil)
		end
		local keys = {}
		for _, k in SceneData.getSkinKeys(actor) do
			if k.skin ~= name then
				table.insert(keys, k)
			end
		end
		SceneData.setSkinKeys(actor, keys)
	end)
end

function App:addSkinFromSelection(actor: Instance)
	local model = selectedModel()
	if not model or model:GetAttribute("BBS_ActorId") then
		self:toast("Выделите модель-скин (не марионетку)", C.warn)
		return
	end
	local copy = cloneModel(model)
	self:mutate("новый скин", function()
		SceneData.addSkin(actor, copy)
	end)
	self:toast("Скин «" .. copy.Name .. "» добавлен", C.good)
end

function App:addSkinFromUser(actor: Instance, text: string)
	self:toast("Загрузка аватара…")
	task.spawn(function()
		local userId, name = Appearance.resolveUser(text)
		if not userId then
			self:toast("Игрок не найден: " .. text, C.warn)
			return
		end
		local rec = SceneData.getRecording(actor)
		local rigName = if rec and rec.rig == "R6" then "R6" else "R15"
		local ok, model = pcall(Appearance.rigFromUserId, userId, rigName)
		if not ok or not model then
			self:toast("Не удалось загрузить аватар: " .. tostring(model), C.warn)
			return
		end
		self:mutate("скин из аватара", function()
			SceneData.addSkin(actor, model, name)
		end)
		self:toast("Скин «" .. tostring(name) .. "» добавлен", C.good)
	end)
end

-- Camera tab -----------------------------------------------------------------

function App:editCamera(name: string, fn: (any) -> ())
	local root = SceneData.getRoot(true)
	local track = SceneData.copyCamera(root)
	fn(track)
	self:mutate(name, function()
		SceneData.setCamera(root, track)
	end)
end

function App:renderCamera()
	local root = SceneData.getRoot(false)
	local track = if root then SceneData.getCamera(root) else CameraTrack.new()
	local sec = UI.section("Камера", self.content)
	UI.paragraph(
		"Летайте камерой Studio (ПКМ + WASD/QE), ставьте курсор на таймлайне и жмите «+ Ключ». Камера плавно пролетит между ключами. Переход «Склейка» держит план до следующего ключа и мгновенно переключает — так снимаются разные кадры (планы).",
		{ Parent = sec }
	)
	UI.row({
		UI.toggle("Смотреть через камеру сцены", self.playback.useCamera, function(v)
			self:setUseCamera(v)
		end),
		UI.cycle({
			{ value = "catmull", label = "Траектория: сплайн" },
			{ value = "linear", label = "Траектория: прямые" },
		}, track.interp, function(v)
			self:editCamera("траектория камеры", function(tr)
				tr.interp = v
			end)
		end),
	}, { Parent = sec })
	UI.row({
		UI.button("+ Ключ из текущего вида", function()
			self:addCameraKey()
		end, { BackgroundColor3 = C.accent }),
		UI.button("Обновить выбранный", function()
			self:updateCameraKey()
		end),
	}, { Parent = sec })

	if #track.keys == 0 then
		UI.paragraph("Ключей пока нет.", { Parent = sec })
		return
	end
	UI.row({
		UI.label("#", { Size = UDim2.fromOffset(26, 20), TextColor3 = C.dim, TextSize = 12 }),
		UI.label("время, с", { Size = UDim2.fromOffset(56, 20), TextColor3 = C.dim, TextSize = 12 }),
		UI.label("FOV", { Size = UDim2.fromOffset(44, 20), TextColor3 = C.dim, TextSize = 12 }),
		UI.label("переход", { Size = UDim2.fromOffset(90, 20), TextColor3 = C.dim, TextSize = 12 }),
	}, { Parent = sec, Size = UDim2.new(1, 0, 0, 20) })

	local easeOptions = {}
	for _, ease in CameraTrack.EASES do
		table.insert(easeOptions, { value = ease, label = CameraTrack.EASE_LABELS[ease] })
	end
	for i, key in track.keys do
		local isSelected = i == self.selectedKey
		local row = UI.row({}, {
			Parent = sec,
			BackgroundTransparency = if isSelected then 0 else 1,
			BackgroundColor3 = C.panel2,
		})
		UI.corner(row, 4)
		UI.button(tostring(i), function()
			self.selectedKey = i
			self:viewCameraKey(i)
		end, { Parent = row, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.fromOffset(26, 24) })
		UI.textbox(UI.formatNumber(key.t), function(text, box)
			local v = UI.parseNumber(text)
			if not v then
				box.Text = UI.formatNumber(key.t)
				return
			end
			self:editCamera("время ключа", function(tr)
				tr.keys[i].t = math.max(0, v)
			end)
		end, { Parent = row, Size = UDim2.fromOffset(56, 24) })
		UI.textbox(UI.formatNumber(key.fov), function(text, box)
			local v = UI.parseNumber(text)
			if not v then
				box.Text = UI.formatNumber(key.fov)
				return
			end
			self:editCamera("FOV ключа", function(tr)
				tr.keys[i].fov = math.clamp(v, 1, 120)
			end)
		end, { Parent = row, Size = UDim2.fromOffset(44, 24) })
		UI.cycle(easeOptions, key.ease, function(v)
			self:editCamera("переход ключа", function(tr)
				tr.keys[i].ease = v
			end)
		end, { Parent = row, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.fromOffset(90, 24) })
		UI.button("Вид", function()
			self.selectedKey = i
			self:viewCameraKey(i)
		end, { Parent = row })
		UI.button("×", function()
			if self.selectedKey == i then
				self.selectedKey = nil
			end
			self:editCamera("удаление ключа", function(tr)
				table.remove(tr.keys, i)
			end)
		end, { Parent = row, BackgroundColor3 = C.danger })
	end
	UI.row({
		UI.button("Удалить все ключи", function()
			self.selectedKey = nil
			self:editCamera("очистка камеры", function(tr)
				table.clear(tr.keys)
			end)
		end, { BackgroundColor3 = C.danger }),
	}, { Parent = sec })
end

function App:addCameraKey()
	local cam = Workspace.CurrentCamera
	local t = self.playback.time
	local newKey = { t = t, cf = cam.CFrame, fov = cam.FieldOfView, ease = "linear" }
	self:editCamera("ключ камеры", function(tr)
		for i = #tr.keys, 1, -1 do
			if math.abs(tr.keys[i].t - t) < 0.01 then
				newKey.ease = tr.keys[i].ease
				table.remove(tr.keys, i)
			end
		end
		table.insert(tr.keys, newKey)
		CameraTrack.sort(tr)
		self.selectedKey = table.find(tr.keys, newKey)
	end)
	self:toast("Ключ камеры на " .. UI.formatTime(t), C.good)
end

function App:updateCameraKey()
	local root = SceneData.getRoot(false)
	local i = self.selectedKey
	if not root or not i or not SceneData.getCamera(root).keys[i] then
		self:toast("Сначала выберите ключ (кнопка с номером)", C.warn)
		return
	end
	local cam = Workspace.CurrentCamera
	self:editCamera("обновление ключа", function(tr)
		tr.keys[i].cf = cam.CFrame
		tr.keys[i].fov = cam.FieldOfView
	end)
end

function App:viewCameraKey(i: number)
	local root = SceneData.getRoot(false)
	local key = root and SceneData.getCamera(root).keys[i]
	if not key then
		return
	end
	self:pausePlayback()
	self:seek(key.t)
	local cam = Workspace.CurrentCamera
	cam.CFrame = key.cf
	cam.Focus = key.cf * CFrame.new(0, 0, -10)
	cam.FieldOfView = key.fov
	self:render()
end

-- Record tab -----------------------------------------------------------------

function App:getSetting(key: string, default: any): any
	local ok, v = pcall(function()
		return self.plugin:GetSetting(key)
	end)
	if ok and v ~= nil then
		return v
	end
	return default
end

function App:setSetting(key: string, value: any)
	pcall(function()
		self.plugin:SetSetting(key, value)
	end)
end

function App:recordConfig()
	local fromCursor = self:getSetting(SETTING_FROM_CURSOR, false)
	return { start = if fromCursor then self.playback.time else 0 }
end

function App:onTestsChanged()
	if self.bridge:hasActiveTests() then
		self.bridge:broadcastConfig(self:recordConfig())
	else
		task.spawn(function()
			self:processQueue()
		end)
	end
	if self.tab == "record" then
		self:render()
	end
end

function App:renderRecord()
	local sec = UI.section("Запись актёра", self.content)
	UI.paragraph(
		"1. Нажмите Play (F5). В тесте откроется окно «BBS Studio — запись».\n"
			.. "2. Нажмите «● Записать» (в окне или в панели сверху экрана игры). После отсчёта играйте: записываются позиция и вся анимация персонажа.\n"
			.. "3. Нажмите «■ Стоп». Дубль сразу появится в тесте — «▶ Просмотр» покажет его. Следующие дубли записываются рядом с прошлыми.\n"
			.. "4. Остановите тест (Shift+F5) — дубли станут актёрами здесь, камера наведётся на нового актёра.",
		{ Parent = sec, TextColor3 = C.text }
	)
	local row = UI.row({}, { Parent = sec })
	UI.label("Кадров/с", { Parent = row, Size = UDim2.fromOffset(58, 24), TextColor3 = C.dim })
	UI.textbox(tostring(self:getSetting(SETTING_FPS, 30)), function(text, box)
		local v = UI.parseNumber(text)
		v = math.clamp(math.floor(v or 30), 5, 60)
		self:setSetting(SETTING_FPS, v)
		box.Text = tostring(v)
	end, { Parent = row, Size = UDim2.fromOffset(44, 24) })
	UI.label("Отсчёт, с", { Parent = row, Size = UDim2.fromOffset(62, 24), TextColor3 = C.dim })
	UI.textbox(tostring(self:getSetting(SETTING_COUNTDOWN, 3)), function(text, box)
		local v = UI.parseNumber(text)
		v = math.clamp(math.floor(v or 3), 0, 10)
		self:setSetting(SETTING_COUNTDOWN, v)
		box.Text = tostring(v)
	end, { Parent = row, Size = UDim2.fromOffset(44, 24) })
	UI.toggle("Начинать сцену с позиции курсора", self:getSetting(SETTING_FROM_CURSOR, false), function(v)
		self:setSetting(SETTING_FROM_CURSOR, v)
		self.bridge:broadcastConfig(self:recordConfig())
	end, { Parent = sec })

	local active = self.bridge:hasActiveTests()
	UI.label(if active then "● Тест запущен, связь с игрой есть" else "Тест не запущен", {
		Parent = sec,
		TextColor3 = if active then C.good else C.dim,
		TextSize = 13,
	})
	if #self.importQueue > 0 then
		UI.row({
			UI.label("Получено записей: " .. #self.importQueue .. " (добавятся после остановки теста)", {
				Size = UDim2.fromOffset(200, 24),
				TextColor3 = C.warn,
			}),
			UI.button("Добавить сейчас", function()
				task.spawn(function()
					self:processQueue()
				end)
			end),
		}, { Parent = sec })
	end

	local pending = self.bridge:getPendingIndex()
	local backup = UI.section("Сохранённые записи", self.content)
	UI.paragraph(
		"Резервная копия каждой записи хранится в настройках плагина, пока её не импортируют. Если запись не появилась автоматически — импортируйте её здесь.",
		{ Parent = backup }
	)
	if #pending == 0 then
		UI.label("Нет записей, ожидающих импорта.", { Parent = backup, TextColor3 = C.dim, TextSize = 13 })
	end
	for _, entry in pending do
		local r = UI.row({}, { Parent = backup })
		local when = if entry.time then os.date("%d.%m %H:%M", entry.time) else ""
		local other = entry.place ~= Bridge.placeKey()
		local label = string.format("%s · %.1f с · %s", Bridge.entryName(entry), entry.length or 0, when)
		UI.flex(UI.label(label .. (if other then " · другой плейс" else ""), {
			Parent = r,
			Size = UDim2.fromOffset(80, 24),
		}))
		UI.button("Импорт", function()
			local str = self.bridge:loadPending(entry.id)
			if not str then
				self.bridge:removePending(entry.id)
				self:render()
				return
			end
			task.spawn(function()
				self:importRecordingString(str)
			end)
		end, { Parent = r, BackgroundColor3 = C.accent })
		UI.button("×", function()
			self.bridge:removePending(entry.id)
			self:render()
		end, { Parent = r, BackgroundColor3 = C.danger })
	end
end

function App:queueImport(str: string)
	table.insert(self.importQueue, str)
	if self.bridge:hasActiveTests() then
		self:toast("Запись получена — добавится после остановки теста", C.good)
		if self.tab == "record" then
			self:render()
		end
	else
		task.spawn(function()
			self:processQueue()
		end)
	end
end

function App:processQueue()
	if self.processing then
		return
	end
	self.processing = true
	while #self.importQueue > 0 and self.alive do
		local str = table.remove(self.importQueue, 1)
		local ok, err = pcall(self.importRecordingString, self, str)
		if not ok then
			Log.error("импорт не удался: " .. tostring(err))
		end
	end
	self.processing = false
end

function App:importRecordingString(str: string)
	local rec = Codec.decodeRecording(str)
	if not rec or #rec.frames == 0 then
		Log.error("получена повреждённая запись (" .. #str .. " байт)")
		return
	end
	if self.importing[rec.id] then
		return
	end
	self.importing[rec.id] = true

	local root = SceneData.getRoot(false)
	if root then
		for _, actor in SceneData.listActors(root) do
			if actor:GetAttribute("RecordingId") == rec.id then
				-- already imported through the other channel
				self.bridge:removePending(rec.id)
				self.importing[rec.id] = nil
				self:render()
				return
			end
		end
	end

	local target = if root and rec.target then SceneData.findActor(root, rec.target) else nil
	local skin = nil
	if not target then
		self:toast("Создаю актёра «" .. rec.name .. "»…")
		local ok, model = pcall(Appearance.rigForRecording, rec)
		if ok and model then
			skin = model
			skin.Name = rec.name
		else
			Log.error(
				"не удалось загрузить аватар для «"
					.. rec.name
					.. "»: "
					.. tostring(model)
					.. ". Добавьте скин вручную: «+ Скин из выделенной модели»."
			)
		end
	end

	local ok = History.record("BBS: импорт записи", function()
		local r = SceneData.getRoot(true)
		if target then
			SceneData.setRecording(target, rec)
			target:SetAttribute("Offset", rec.offset or 0)
			self.selected = target
		else
			self.selected = SceneData.createActor(r, {
				name = rec.name,
				rec = rec,
				skin = skin,
				offset = rec.offset or 0,
			})
		end
	end)
	if ok then
		self.bridge:removePending(rec.id)
		Log.info(string.format("актёр «%s» добавлен: %.1f с, %d кадров", rec.name, rec.length, #rec.frames))
		self.tab = "actors"
	end
	self.importing[rec.id] = nil
	self:onDataChanged()
	if ok and self.selected then
		self:focusActor(self.selected)
	end
end

-- Scene tab ------------------------------------------------------------------

function App:setRootAttribute(name: string, value: any)
	self:mutate("настройка сцены", function()
		local root = SceneData.getRoot(true) :: Folder
		root:SetAttribute(name, value)
	end)
end

function App:renderScene()
	local root = SceneData.getRoot(false)
	local function attr(name: string, default: any): any
		local v = root and root:GetAttribute(name)
		if v == nil then
			return default
		end
		return v
	end

	local sec = UI.section("Сцена", self.content)
	local row = UI.row({}, { Parent = sec })
	UI.label("Длина, с (0 = авто)", { Parent = row, Size = UDim2.fromOffset(120, 24), TextColor3 = C.dim })
	UI.textbox(UI.formatNumber(attr("Length", 0)), function(text, box)
		local v = UI.parseNumber(text)
		if v then
			self:setRootAttribute("Length", math.max(0, v))
		else
			box.Text = UI.formatNumber(attr("Length", 0))
		end
	end, { Parent = row, Size = UDim2.fromOffset(50, 24) })
	if root then
		UI.label("авто: " .. UI.formatNumber(SceneData.autoLength(root)) .. " с", {
			Parent = row,
			Size = UDim2.fromOffset(90, 24),
			TextColor3 = C.dim,
		})
	end
	UI.row({
		UI.button("Пересоздать марионеток", function()
			self.playback:invalidate()
			self:onDataChanged()
		end),
		UI.button("Показать данные сцены", function()
			if root then
				Selection:Set({ root })
			end
		end),
	}, { Parent = sec })
	UI.button(if self.confirmClear then "Точно удалить всю сцену?" else "Очистить сцену", function()
		if not self.confirmClear then
			self.confirmClear = true
			self:render()
			task.delay(4, function()
				if self.confirmClear then
					self.confirmClear = false
					self:render()
				end
			end)
			return
		end
		self.confirmClear = false
		self.selected = nil
		self.selectedKey = nil
		self:mutate("очистка сцены", function()
			local r = SceneData.getRoot(false)
			if r then
				r.Parent = nil
			end
		end)
	end, { Parent = sec, BackgroundColor3 = C.danger })

	local player = UI.section("Проигрыватель в игре", self.content)
	UI.paragraph(
		"Устанавливает скрипт, который проигрывает сцену в запущенной игре (актёры, смены скинов, камера, кинорамка). Так фильм можно снять записью экрана прямо из игры.",
		{ Parent = player }
	)
	local keyRow = UI.row({}, { Parent = player })
	UI.label("Клавиша", { Parent = keyRow, Size = UDim2.fromOffset(56, 24), TextColor3 = C.dim })
	UI.textbox(attr("PlayerKey", "P"), function(text, box)
		local ok, key = pcall(function()
			return Enum.KeyCode[text]
		end)
		if ok and key then
			self:setRootAttribute("PlayerKey", key.Name)
		else
			box.Text = attr("PlayerKey", "P")
			self:toast("Неизвестная клавиша. Примеры: P, F, One, F6", C.warn)
		end
	end, { Parent = keyRow, Size = UDim2.fromOffset(60, 24) })
	UI.toggle("Автозапуск", attr("Autoplay", false), function(v)
		self:setRootAttribute("Autoplay", v)
	end, { Parent = keyRow })
	UI.row({
		UI.toggle("Скрывать игрока", attr("HidePlayer", true), function(v)
			self:setRootAttribute("HidePlayer", v)
		end),
		UI.toggle("Кинорамка", attr("Letterbox", true), function(v)
			self:setRootAttribute("Letterbox", v)
		end),
		UI.toggle("Петля", attr("Loop", false), function(v)
			self:setRootAttribute("Loop", v)
		end),
	}, { Parent = player })

	local sps = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
	local installed = ReplicatedStorage:FindFirstChild(RUNTIME_FOLDER) ~= nil
		and sps ~= nil
		and sps:FindFirstChild(RUNTIME_SCRIPT) ~= nil
	UI.label(if installed then "✓ Установлен" else "Не установлен", {
		Parent = player,
		TextColor3 = if installed then C.good else C.dim,
		TextSize = 13,
	})
	UI.row({
		UI.button(if installed then "Обновить" else "Установить", function()
			self:installRuntime()
		end, { BackgroundColor3 = C.accent }),
		UI.button("Удалить", function()
			self:mutate("удаление проигрывателя", function()
				local folder = ReplicatedStorage:FindFirstChild(RUNTIME_FOLDER)
				if folder then
					folder.Parent = nil
				end
				local s = sps and sps:FindFirstChild(RUNTIME_SCRIPT)
				if s then
					s.Parent = nil
				end
			end)
		end),
	}, { Parent = player })

	self:renderDiagnostics()
end

function App:renderDiagnostics()
	local sec = UI.section("Диагностика", self.content)
	local root = SceneData.getRoot(false)
	local actors = if root then SceneData.listActors(root) else {}
	local puppets = 0
	for _, actor in actors do
		if self.playback:getPuppet(actor) then
			puppets += 1
		end
	end
	local lines = {
		Version.LABEL,
		"Связь с тестами: " .. (if self.bridge.available then "PluginConnectionService" else "только резервное сохранение"),
		"Активных тестов: " .. (if self.bridge:hasActiveTests() then "есть" else "нет"),
		string.format("Актёров: %d · видимых марионеток сейчас: %d", #actors, puppets),
		"Ожидают импорта: " .. (#self.bridge:getPendingIndex() + #self.importQueue),
	}
	for _, line in lines do
		UI.label(line, { Parent = sec, TextSize = 13, TextColor3 = C.dim })
	end
	UI.label("Журнал", { Parent = sec, Font = UI.FONT_BOLD })
	local entries = Log.entries
	if #entries == 0 then
		UI.label("пусто", { Parent = sec, TextSize = 12, TextColor3 = C.dim })
	end
	for i = #entries, math.max(1, #entries - 19), -1 do
		local e = entries[i]
		UI.paragraph(os.date("%H:%M:%S", e.time) .. "  " .. e.text, {
			Parent = sec,
			TextSize = 12,
			TextColor3 = if e.level == "error" then C.danger elseif e.level == "warn" then C.warn else C.text,
		})
	end
end

function App:installRuntime()
	local ok = History.record("BBS: установка проигрывателя", function()
		SceneData.getRoot(true)
		local old = ReplicatedStorage:FindFirstChild(RUNTIME_FOLDER)
		if old then
			old.Parent = nil
		end
		local runtime = Shared:Clone()
		runtime.Name = RUNTIME_FOLDER
		runtime.Parent = ReplicatedStorage

		local sps = StarterPlayer:WaitForChild("StarterPlayerScripts")
		local oldScript = sps:FindFirstChild(RUNTIME_SCRIPT)
		if oldScript then
			oldScript.Parent = nil
		end
		local localScript = Instance.new("LocalScript")
		localScript.Name = RUNTIME_SCRIPT
		localScript.Source = RUNTIME_SOURCE
		localScript.Parent = sps
	end)
	if ok then
		self:toast("Проигрыватель установлен. В игре нажмите клавишу, чтобы запустить сцену.", C.good)
	else
		self:toast("Не удалось установить (разрешите плагину изменять скрипты)", C.warn)
	end
	self:onDataChanged()
end
return App
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Appearance</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Avatar appearance: serialising the recorded player's HumanoidDescription and building skins.
local Players = game:GetService("Players")

local Appearance = {}

local NUMBER_PROPS = {
	"Face",
	"Head",
	"LeftArm",
	"LeftLeg",
	"RightArm",
	"RightLeg",
	"Torso",
	"Shirt",
	"Pants",
	"GraphicTShirt",
	"BodyTypeScale",
	"DepthScale",
	"HeadScale",
	"HeightScale",
	"ProportionScale",
	"WidthScale",
}
local STRING_PROPS = {
	"HatAccessory",
	"HairAccessory",
	"FaceAccessory",
	"NeckAccessory",
	"ShouldersAccessory",
	"FrontAccessory",
	"BackAccessory",
	"WaistAccessory",
}
local COLOR_PROPS = {
	"HeadColor",
	"LeftArmColor",
	"LeftLegColor",
	"RightArmColor",
	"RightLegColor",
	"TorsoColor",
}

function Appearance.serialize(desc: HumanoidDescription)
	local data = {}
	local d = desc :: any
	for _, prop in NUMBER_PROPS do
		pcall(function()
			data[prop] = d[prop]
		end)
	end
	for _, prop in STRING_PROPS do
		pcall(function()
			data[prop] = d[prop]
		end)
	end
	for _, prop in COLOR_PROPS do
		pcall(function()
			data[prop] = d[prop]:ToHex()
		end)
	end
	pcall(function()
		local list = {}
		for _, acc in desc:GetAccessories(true) do
			table.insert(list, {
				AssetId = acc.AssetId,
				AccessoryType = acc.AccessoryType.Name,
				IsLayered = acc.IsLayered,
				Order = acc.Order,
				Puffiness = acc.Puffiness,
			})
		end
		data._accessories = list
	end)
	return data
end

function Appearance.deserialize(data): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	local d = desc :: any
	if type(data) ~= "table" then
		return desc
	end
	for _, prop in NUMBER_PROPS do
		if type(data[prop]) == "number" then
			pcall(function()
				d[prop] = data[prop]
			end)
		end
	end
	for _, prop in STRING_PROPS do
		if type(data[prop]) == "string" then
			pcall(function()
				d[prop] = data[prop]
			end)
		end
	end
	for _, prop in COLOR_PROPS do
		if type(data[prop]) == "string" then
			pcall(function()
				d[prop] = Color3.fromHex(data[prop])
			end)
		end
	end
	if type(data._accessories) == "table" then
		pcall(function()
			local list = {}
			for _, acc in data._accessories do
				local entry = table.clone(acc)
				entry.AccessoryType = Enum.AccessoryType[acc.AccessoryType]
				table.insert(list, entry)
			end
			desc:SetAccessories(list, true)
		end)
	end
	return desc
end

-- Calls the *Async API where it exists and falls back to the legacy name.
local function callPlayers(asyncName: string, legacyName: string, ...)
	local args = table.pack(...)
	local p = Players :: any
	local ok, result = pcall(function()
		return p[asyncName](p, table.unpack(args, 1, args.n))
	end)
	if ok then
		return result
	end
	local ok2, result2 = pcall(function()
		return p[legacyName](p, table.unpack(args, 1, args.n))
	end)
	if ok2 then
		return result2
	end
	error(result2 or result, 0)
end

local function rigType(rigName: string?): Enum.HumanoidRigType
	return if rigName == "R6" then Enum.HumanoidRigType.R6 else Enum.HumanoidRigType.R15
end

function Appearance.rigFromDescription(desc: HumanoidDescription, rigName: string?): Model
	return callPlayers("CreateHumanoidModelFromDescriptionAsync", "CreateHumanoidModelFromDescription", desc, rigType(rigName))
end

function Appearance.rigFromUserId(userId: number, rigName: string?): Model
	local desc = callPlayers("GetHumanoidDescriptionFromUserIdAsync", "GetHumanoidDescriptionFromUserId", userId)
	return Appearance.rigFromDescription(desc, rigName)
end

function Appearance.resolveUser(text: string): (number?, string?)
	text = string.match(text, "^%s*(.-)%s*$") or ""
	if text == "" then
		return nil, nil
	end
	local id = tonumber(text)
	if not id then
		local ok, result = pcall(function()
			return Players:GetUserIdFromNameAsync(text)
		end)
		id = if ok then result else nil
	end
	if not id then
		return nil, nil
	end
	local okName, name = pcall(function()
		return Players:GetNameFromUserIdAsync(id)
	end)
	return id, if okName then name else tostring(id)
end

-- Best-effort rig matching the recorded character: its description, then its user, then a default.
function Appearance.rigForRecording(rec): Model
	if rec.desc then
		local ok, model = pcall(function()
			return Appearance.rigFromDescription(Appearance.deserialize(rec.desc), rec.rig)
		end)
		if ok and model then
			return model
		end
	end
	if rec.userId and rec.userId > 0 then
		local ok, model = pcall(Appearance.rigFromUserId, rec.userId, rec.rig)
		if ok and model then
			return model
		end
	end
	return Appearance.rigFromDescription(Instance.new("HumanoidDescription"), rec.rig)
end

return Appearance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Bridge</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Moves recordings from the playtest client back to the edit session.
-- Channel 1: PluginConnectionService messages (split into parts).
-- Channel 2: plugin settings, which outlive the playtest; the edit side polls and imports them.
local HttpService = game:GetService("HttpService")

local Log = require(script.Parent.Parent.Shared.Log)

local Bridge = {}
Bridge.__index = Bridge

local INDEX_KEY = "BBS_PendingIndex2"
local REC_PREFIX = "BBS_Rec2_"
local MSG_PART = "BBS_PART\n"
local MSG_CFG = "BBS_CFG\n"
local MSG_HELLO = "BBS_HELLO\n"
local PART_SIZE = 60000
local MAX_PENDING = 30

local function getService()
	local ok, service = pcall(function()
		return game:GetService("PluginConnectionService")
	end)
	return if ok then service else nil
end

local function startsWith(s: string, prefix: string): boolean
	return string.sub(s, 1, #prefix) == prefix
end

-- Identifies the place so backups recorded in one place are not auto-imported into another.
function Bridge.placeKey(): string
	if game.PlaceId ~= 0 then
		return "id:" .. tostring(game.PlaceId)
	end
	return "local"
end

function Bridge.new(plugin: Plugin)
	local self = setmetatable({}, Bridge)
	self.plugin = plugin
	self.tests = {}
	self.partial = {}
	self.editConnection = nil
	self.available = getService() ~= nil
	return self
end

-- Backup storage -------------------------------------------------------------

function Bridge:getPendingIndex()
	local ok, index = pcall(function()
		return self.plugin:GetSetting(INDEX_KEY)
	end)
	if not ok or type(index) ~= "table" then
		return {}
	end
	return index
end

function Bridge:savePending(rec, str: string): (boolean, string?)
	local ok, err = pcall(function()
		self.plugin:SetSetting(REC_PREFIX .. rec.id, str)
		local index = self:getPendingIndex()
		table.insert(index, {
			id = rec.id,
			name = HttpService:UrlEncode(rec.name),
			length = rec.length,
			time = os.time(),
			place = Bridge.placeKey(),
		})
		while #index > MAX_PENDING do
			local old = table.remove(index, 1)
			self.plugin:SetSetting(REC_PREFIX .. old.id, nil)
		end
		self.plugin:SetSetting(INDEX_KEY, index)
	end)
	return ok, if ok then nil else tostring(err)
end

function Bridge:loadPending(id: string): string?
	local ok, str = pcall(function()
		return self.plugin:GetSetting(REC_PREFIX .. id)
	end)
	return if ok and type(str) == "string" then str else nil
end

function Bridge:removePending(id: string)
	pcall(function()
		self.plugin:SetSetting(REC_PREFIX .. id, nil)
		local index = self:getPendingIndex()
		for i = #index, 1, -1 do
			if index[i].id == id then
				table.remove(index, i)
			end
		end
		self.plugin:SetSetting(INDEX_KEY, index)
	end)
end

function Bridge.entryName(entry): string
	local ok, name = pcall(function()
		return HttpService:UrlDecode(entry.name)
	end)
	return if ok and type(name) == "string" then name else tostring(entry.name)
end

-- Edit side ------------------------------------------------------------------

function Bridge:onMessage(msg, onRecording: (string) -> ())
	if type(msg) ~= "string" then
		return
	end
	if startsWith(msg, MSG_HELLO) then
		Log.info("связь с тестом установлена")
		return
	end
	if not startsWith(msg, MSG_PART) then
		return
	end
	-- BBS_PART\n<id>\n<index>\n<count>\n<data>
	local id, index, count, data = string.match(msg, "^BBS_PART\n([^\n]+)\n(%d+)\n(%d+)\n(.*)$")
	if not id then
		return
	end
	local i, n = tonumber(index), tonumber(count)
	local entry = self.partial[id]
	if not entry then
		entry = { parts = {}, received = 0, count = n }
		self.partial[id] = entry
	end
	if not entry.parts[i] then
		entry.parts[i] = data
		entry.received += 1
	end
	if entry.received >= entry.count then
		self.partial[id] = nil
		onRecording(table.concat(entry.parts, "", 1, entry.count))
	end
end

function Bridge:listenFromTests(onRecording: (string) -> (), onChanged: () -> ())
	local service = getService()
	if not service then
		Log.warn("PluginConnectionService недоступен — записи будут передаваться через резервное сохранение")
		return
	end
	local testType
	local ok, err = pcall(function()
		testType = Enum.PluginConnectionTargetType.Test
		if not service:CanHaveConnectionType(testType) then
			error("CanHaveConnectionType(Test) = false")
		end
	end)
	if not ok then
		Log.warn("связь с тестами недоступна (" .. tostring(err) .. ") — используется резервное сохранение")
		return
	end
	local function bind(conn)
		if self.tests[conn] or not conn.Connected then
			return
		end
		local binding = conn:BindToMessage(function(msg)
			self:onMessage(msg, onRecording)
		end)
		self.tests[conn] = binding
		conn:GetPropertyChangedSignal("Connected"):Connect(function()
			if not conn.Connected and self.tests[conn] then
				self.tests[conn]:Disconnect()
				self.tests[conn] = nil
				onChanged()
			end
		end)
		onChanged()
	end
	for _, conn in service:GetPluginConnectionsOfType(testType) do
		bind(conn)
	end
	service.Connected:Connect(function(conn)
		if conn.Type == testType then
			bind(conn)
		end
	end)
end

function Bridge:hasActiveTests(): boolean
	return next(self.tests) ~= nil
end

function Bridge:broadcastConfig(config)
	local msg = MSG_CFG .. HttpService:JSONEncode(config)
	for conn in self.tests do
		pcall(function()
			if conn.Connected then
				conn:SendMessage(msg)
			end
		end)
	end
end

-- Playtest side --------------------------------------------------------------

function Bridge:connectToEdit(onConfig: (any) -> (), onConnected: () -> ())
	local service = getService()
	if not service then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			local editType = Enum.PluginConnectionTargetType.Edit
			if not service:CanHaveConnectionType(editType) then
				return
			end
			local conn = service:GetPluginConnectionsOfType(editType)[1]
			while not conn do
				local candidate = service.Connected:Wait()
				if candidate.Type == editType then
					conn = candidate
				end
			end
			self.editConnection = conn
			conn:BindToMessage(function(msg)
				if type(msg) == "string" and startsWith(msg, MSG_CFG) then
					local okDecode, config = pcall(function()
						return HttpService:JSONDecode(string.sub(msg, #MSG_CFG + 1))
					end)
					if okDecode and type(config) == "table" then
						onConfig(config)
					end
				end
			end)
			conn:SendMessage(MSG_HELLO)
			onConnected()
		end)
		if not ok then
			Log.warn("нет связи с редактором: " .. tostring(err))
		end
	end)
end

function Bridge:isConnectedToEdit(): boolean
	local conn = self.editConnection
	return conn ~= nil and conn.Connected
end

function Bridge:sendToEdit(id: string, str: string): (boolean, string?)
	local conn = self.editConnection
	if not conn then
		return false, "нет соединения"
	end
	local ok, err = pcall(function()
		assert(conn.Connected, "соединение закрыто")
		local count = math.max(1, math.ceil(#str / PART_SIZE))
		for i = 1, count do
			local data = string.sub(str, (i - 1) * PART_SIZE + 1, i * PART_SIZE)
			conn:SendMessage(MSG_PART .. id .. "\n" .. i .. "\n" .. count .. "\n" .. data)
		end
	end)
	return ok, if ok then nil else tostring(err)
end

return Bridge
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">History</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Wraps scene edits in ChangeHistoryService recordings so Ctrl+Z works.
local ChangeHistoryService = game:GetService("ChangeHistoryService")

local History = {}

function History.record(name: string, fn: () -> ()): boolean
	local id = nil
	pcall(function()
		id = ChangeHistoryService:TryBeginRecording(name, name)
	end)
	local ok, err = pcall(fn)
	if id then
		ChangeHistoryService:FinishRecording(
			id,
			if ok then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel
		)
	end
	if not ok then
		warn("[BBS Studio] " .. name .. ": " .. tostring(err))
	end
	return ok
end

return History
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">PlayApp</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Playtest-client window: records the local character while the scene plays around it.
-- Each take also becomes a local actor right away, so it can be previewed without leaving Play.
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = script.Parent.Parent.Shared
local Codec = require(Shared.Codec)
local SceneData = require(Shared.SceneData)
local Playback = require(Shared.Playback)
local Log = require(Shared.Log)

local UI = require(script.Parent.UI)
local Bridge = require(script.Parent.Bridge)
local Recorder = require(script.Parent.Recorder)
local Version = require(script.Parent.Version)

local C = UI.C
local SETTING_FPS = "BBS_RecordFPS"
local SETTING_COUNTDOWN = "BBS_RecordCountdown"
local SETTING_AUTO_OPEN = "BBS_AutoOpenRecorder"
local SETTING_HUD = "BBS_ShowHud"

local PlayApp = {}

local function getSetting(plugin: Plugin, key: string, default: any): any
	local ok, v = pcall(function()
		return plugin:GetSetting(key)
	end)
	if ok and v ~= nil then
		return v
	end
	return default
end

local function setSetting(plugin: Plugin, key: string, value: any)
	pcall(function()
		plugin:SetSetting(key, value)
	end)
end

local function cloneCharacter(character: Model): Model?
	local was = character.Archivable
	character.Archivable = true
	local ok, copy = pcall(function()
		return character:Clone()
	end)
	character.Archivable = was
	if not ok or not copy then
		return nil
	end
	for _, d in copy:GetDescendants() do
		if d:IsA("ForceField") or d:IsA("Sound") then
			d:Destroy()
		end
	end
	return copy
end

local function buildHud()
	local gui = Instance.new("ScreenGui")
	gui.Name = "BBS_RecordHud"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local bar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.15,
		Parent = gui,
	})
	UI.corner(bar, 8)
	UI.pad(bar, 6, 6, 6, 6)
	UI.list(bar, true, 6)
	local label = UI.label("BBS", {
		Font = UI.FONT_BOLD,
		TextSize = 16,
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = bar,
	})
	local recordButton = UI.button("● Записать", nil, { Parent = bar, BackgroundColor3 = C.record, Font = UI.FONT_BOLD })
	local previewButton = UI.button("▶ Просмотр", nil, { Parent = bar })

	local countdown = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(200, 120),
		TextSize = 96,
		Font = UI.FONT_BOLD,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = gui,
	})

	local ok = pcall(function()
		gui.Parent = CoreGui
	end)
	if not ok then
		local player = Players.LocalPlayer
		gui.Parent = player and player:FindFirstChildOfClass("PlayerGui")
	end
	return { gui = gui, label = label, record = recordButton, preview = previewButton, countdown = countdown }
end

function PlayApp.start(plugin: Plugin)
	local player = Players.LocalPlayer
	local bridge = Bridge.new(plugin)
	local recorder = Recorder.new()
	local playback = Playback.new({ folderName = "BBS_LocalPuppets" })
	playback.onError = function(text)
		Log.error(text)
	end
	local hud = buildHud()
	hud.gui.Enabled = getSetting(plugin, SETTING_HUD, true)

	local state: string = "idle" -- idle | countdown | recording | preview
	local function currentState(): string
		return state
	end
	local config = { start = 0 }
	local take = 1
	local baseName = if player then player.DisplayName else "Актёр"
	local nameText = baseName
	local targetId = nil
	local playScene = true
	local sceneCamera = false
	local session = {}
	local timerConn = nil
	local savedCameraType = nil
	local connected = false

	local toolbar = plugin:CreateToolbar("BBS Studio")
	local button = toolbar:CreateButton("BBSStudioRecord", "Окно записи BBS Studio", "", "BBS запись")
	button.ClickableWhenViewportHidden = true
	local autoOpen = getSetting(plugin, SETTING_AUTO_OPEN, true)
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, autoOpen, autoOpen, 360, 560, 300, 300)
	local widget = UI.createWidget(plugin, "BBSStudio_Play", info)
	widget.Title = "BBS Studio — запись"
	widget.Name = "BBSStudioRecorder"
	button.Click:Connect(function()
		widget.Enabled = not widget.Enabled
	end)
	widget:GetPropertyChangedSignal("Enabled"):Connect(function()
		button:SetActive(widget.Enabled)
	end)
	button:SetActive(widget.Enabled)

	local root = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.bg,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = widget,
	})
	UI.list(root, false, 6)
	UI.pad(root, 8, 10, 8, 8)

	local render -- forward declaration
	local statusLabel, startBox
	local statusText = if player and player.Character then "Готово к записи" else "Ждём персонажа…"
	local statusColor = C.text

	local function setStatus(text: string, color: Color3?)
		statusText = text
		statusColor = color or C.text
		if statusLabel then
			statusLabel.Text = statusText
			statusLabel.TextColor3 = statusColor
		end
		hud.label.Text = statusText
		hud.label.TextColor3 = statusColor
	end

	local function updateHud()
		local busy = state == "countdown" or state == "recording"
		hud.record.Text = if busy then "■ Стоп" else "● Записать"
		UI.recolor(hud.record, if busy then C.panel2 else C.record)
		hud.preview.Visible = not busy
		hud.preview.Text = if state == "preview" then "■ Стоп просмотра" else "▶ Просмотр"
	end

	local function restoreCamera()
		if savedCameraType then
			Workspace.CurrentCamera.CameraType = savedCameraType
			savedCameraType = nil
		end
	end

	local function startScene(from: number, useCamera: boolean)
		local dataRoot = SceneData.getRoot(false)
		if not dataRoot then
			return
		end
		playback.exclude = if targetId and state == "recording" then { [targetId] = true } else {}
		local hasCamera = #SceneData.getCamera(dataRoot).keys > 0
		playback.useCamera = useCamera and hasCamera
		if playback.useCamera then
			savedCameraType = Workspace.CurrentCamera.CameraType
			Workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
		end
		playback:refresh()
		playback:play(from)
	end

	local function stopScene()
		playback:destroy()
		restoreCamera()
	end

	local function addLocalTake(rec)
		local dataRoot = SceneData.getRoot(true)
		local target = if targetId then SceneData.findActor(dataRoot, targetId) else nil
		if target then
			SceneData.setRecording(target, rec)
			target:SetAttribute("Offset", rec.offset or 0)
			return
		end
		local character = player and player.Character
		local skin = if character then cloneCharacter(character) else nil
		local actor = SceneData.createActor(dataRoot, {
			name = rec.name,
			rec = rec,
			skin = skin,
			offset = rec.offset or 0,
		})
		actor:SetAttribute("BBS_LocalTake", true)
	end

	local function stopRecording()
		if state == "countdown" then
			state = "idle"
			hud.countdown.Text = ""
			setStatus("Отменено", C.dim)
			render()
			return
		end
		if state ~= "recording" then
			return
		end
		state = "idle"
		if timerConn then
			timerConn:Disconnect()
			timerConn = nil
		end
		local rec = recorder:stop()
		stopScene()
		if not rec or #rec.frames < 2 then
			setStatus("Слишком короткая запись", C.warn)
			render()
			return
		end
		rec.name = nameText
		rec.offset = config.start or 0
		rec.target = targetId
		local str = Codec.encodeRecording(rec)
		local saved, saveErr = bridge:savePending(rec, str)
		local sent, sendErr = bridge:sendToEdit(rec.id, str)
		local okLocal, localErr = pcall(addLocalTake, rec)
		if not okLocal then
			Log.error("не удалось показать дубль в тесте: " .. tostring(localErr))
		end
		Log.info(
			string.format(
				"дубль «%s»: %.1f с, %d кадров, %d суставов, %d КБ · редактор: %s · резерв: %s",
				rec.name,
				rec.length,
				#rec.frames,
				#rec.parts,
				math.ceil(#str / 1024),
				if sent then "отправлен" else "нет (" .. tostring(sendErr) .. ")",
				if saved then "сохранён" else "ошибка (" .. tostring(saveErr) .. ")"
			)
		)
		table.insert(session, { name = rec.name, length = rec.length, sent = sent, saved = saved })
		if sent or saved then
			setStatus("✓ Дубль готов — «▶ Просмотр»", C.good)
		else
			setStatus("× Запись не сохранена — см. Output", C.danger)
		end
		if not targetId then
			take += 1
			nameText = baseName .. " " .. take
		end
		render()
	end

	local function startRecording()
		if state == "preview" then
			stopScene()
			state = "idle"
		end
		if state ~= "idle" then
			return
		end
		if not player or not player.Character then
			setStatus("Нет персонажа — запустите Play (F5)", C.warn)
			return
		end
		state = "countdown"
		render()
		local countdown = math.clamp(tonumber(getSetting(plugin, SETTING_COUNTDOWN, 3)) or 3, 0, 10)
		task.spawn(function()
			for i = countdown, 1, -1 do
				if currentState() ~= "countdown" then
					return
				end
				setStatus("Запись через " .. i .. "…", C.warn)
				hud.countdown.Text = tostring(i)
				task.wait(1)
			end
			hud.countdown.Text = ""
			if currentState() ~= "countdown" then
				return
			end
			local ok, err = recorder:start({
				fps = tonumber(getSetting(plugin, SETTING_FPS, 30)) or 30,
				name = nameText,
			})
			if not ok then
				state = "idle"
				setStatus(err or "Ошибка", C.danger)
				render()
				return
			end
			state = "recording"
			if playScene then
				startScene(config.start or 0, sceneCamera)
			end
			timerConn = RunService.Heartbeat:Connect(function()
				setStatus("● REC " .. UI.formatTime(recorder.elapsed), C.record)
			end)
			render()
		end)
	end

	local function toggleRecording()
		if state == "idle" or state == "preview" then
			startRecording()
		else
			stopRecording()
		end
	end

	local function togglePreview()
		if state == "preview" then
			stopScene()
			state = "idle"
		elseif state == "idle" then
			local dataRoot = SceneData.getRoot(false)
			if not dataRoot or #SceneData.listActors(dataRoot) == 0 then
				setStatus("Смотреть пока нечего — запишите дубль", C.warn)
				return
			end
			state = "preview"
			startScene(0, true)
			setStatus("▶ Просмотр сцены", C.accent)
		end
		render()
	end

	playback.onStopped = function()
		if state == "preview" then
			stopScene()
			state = "idle"
			setStatus("Просмотр окончен", C.dim)
			render()
		end
	end

	hud.record.Activated:Connect(toggleRecording)
	hud.preview.Activated:Connect(togglePreview)

	render = function()
		updateHud()
		UI.clear(root)
		local busy = state == "countdown" or state == "recording"
		local sec = UI.section("Запись актёра", root)
		statusLabel = UI.label("", { Parent = sec, Font = UI.FONT_BOLD, TextSize = 18, Size = UDim2.new(1, 0, 0, 26) })
		setStatus(statusText, statusColor)
		UI.label(
			if connected
				then "● Связь с редактором есть"
				else "○ Связи с редактором нет — записи сохраняются в резерв и подтянутся сами",
			{ Parent = sec, TextSize = 12, TextColor3 = if connected then C.good else C.warn, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y }
		)

		local nameRow = UI.row({}, { Parent = sec })
		UI.label("Имя", { Parent = nameRow, Size = UDim2.fromOffset(60, 24), TextColor3 = C.dim })
		UI.flex(UI.textbox(nameText, function(text)
			if text ~= "" then
				nameText = text
			end
		end, { Parent = nameRow, Size = UDim2.fromOffset(100, 24) }))

		local options = { { value = false, label = "Новый актёр" } }
		local dataRoot = SceneData.getRoot(false)
		if dataRoot then
			for _, actor in SceneData.listActors(dataRoot) do
				table.insert(options, { value = actor.Name, label = "Перезаписать: " .. SceneData.getName(actor) })
			end
		end
		local targetRow = UI.row({}, { Parent = sec })
		UI.label("Цель", { Parent = targetRow, Size = UDim2.fromOffset(60, 24), TextColor3 = C.dim })
		UI.flex(UI.cycle(options, targetId or false, function(v)
			targetId = if v then v else nil
			if targetId and dataRoot then
				local actor = SceneData.findActor(dataRoot, targetId)
				if actor then
					nameText = SceneData.getName(actor)
				end
			else
				nameText = baseName .. (if take > 1 then " " .. take else "")
			end
			render()
		end, { Parent = targetRow, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.fromOffset(100, 24) }))

		local startRow = UI.row({}, { Parent = sec })
		UI.label("Старт, с", { Parent = startRow, Size = UDim2.fromOffset(60, 24), TextColor3 = C.dim })
		startBox = UI.textbox(UI.formatNumber(config.start or 0), function(text, box)
			local v = UI.parseNumber(text)
			config.start = math.max(0, v or config.start or 0)
			box.Text = UI.formatNumber(config.start)
		end, { Parent = startRow, Size = UDim2.fromOffset(50, 24) })
		UI.label("время сцены, с которого начнётся дубль", {
			Parent = startRow,
			Size = UDim2.fromOffset(200, 24),
			TextColor3 = C.dim,
			TextSize = 12,
		})

		UI.row({
			UI.toggle("Сцена во время записи", playScene, function(v)
				playScene = v
			end),
			UI.toggle("Камера сцены", sceneCamera, function(v)
				sceneCamera = v
			end),
		}, { Parent = sec })

		UI.button(if busy then "■  Стоп" else "●  Записать", toggleRecording, {
			Parent = sec,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.new(1, 0, 0, 38),
			TextSize = 18,
			Font = UI.FONT_BOLD,
			BackgroundColor3 = if busy then C.panel2 else C.record,
		})
		if not busy then
			UI.button(if state == "preview" then "■ Остановить просмотр" else "▶ Просмотр сцены (с камерой)", togglePreview, {
				Parent = sec,
				AutomaticSize = Enum.AutomaticSize.None,
				Size = UDim2.new(1, 0, 0, 28),
			})
		end

		if #session > 0 then
			local list = UI.section("Дубли в этом тесте", root)
			for _, entry in session do
				local mark = if entry.sent then "✓ в редакторе" elseif entry.saved then "• в резерве" else "× не сохранён"
				UI.label(string.format("%s · %.1f с · %s", entry.name, entry.length, mark), { Parent = list, TextSize = 13 })
			end
			UI.paragraph(
				"Дубли уже играют в этом тесте. В редакторе они станут актёрами после остановки теста (Shift+F5).",
				{ Parent = list }
			)
		end

		local settings = UI.section("Настройки", root)
		local row = UI.row({}, { Parent = settings })
		UI.label("Кадров/с", { Parent = row, Size = UDim2.fromOffset(58, 24), TextColor3 = C.dim })
		UI.textbox(tostring(getSetting(plugin, SETTING_FPS, 30)), function(text, box)
			local v = math.clamp(math.floor(UI.parseNumber(text) or 30), 5, 60)
			setSetting(plugin, SETTING_FPS, v)
			box.Text = tostring(v)
		end, { Parent = row, Size = UDim2.fromOffset(40, 24) })
		UI.label("Отсчёт, с", { Parent = row, Size = UDim2.fromOffset(62, 24), TextColor3 = C.dim })
		UI.textbox(tostring(getSetting(plugin, SETTING_COUNTDOWN, 3)), function(text, box)
			local v = math.clamp(math.floor(UI.parseNumber(text) or 3), 0, 10)
			setSetting(plugin, SETTING_COUNTDOWN, v)
			box.Text = tostring(v)
		end, { Parent = row, Size = UDim2.fromOffset(40, 24) })
		UI.toggle("Кнопки записи поверх игры", hud.gui.Enabled, function(v)
			hud.gui.Enabled = v
			setSetting(plugin, SETTING_HUD, v)
		end, { Parent = settings })
		UI.toggle("Открывать это окно при запуске теста", getSetting(plugin, SETTING_AUTO_OPEN, true), function(v)
			setSetting(plugin, SETTING_AUTO_OPEN, v)
		end, { Parent = settings })
		UI.paragraph(
			"Горячие клавиши: File → Customize Shortcuts → «BBS: запись / стоп» и «BBS: просмотр». " .. Version.LABEL,
			{ Parent = settings }
		)
	end

	bridge:connectToEdit(function(cfg)
		if type(cfg.start) == "number" then
			config.start = cfg.start
			if startBox and state == "idle" then
				startBox.Text = UI.formatNumber(config.start)
			end
		end
	end, function()
		connected = true
		if state == "idle" then
			render()
		end
	end)

	pcall(function()
		local action = plugin:CreatePluginAction(
			"BBSStudio_ToggleRecord",
			"BBS: запись / стоп",
			"Начать или остановить запись актёра BBS Studio",
			"",
			true
		)
		action.Triggered:Connect(toggleRecording)
		local previewAction = plugin:CreatePluginAction(
			"BBSStudio_TogglePreview",
			"BBS: просмотр",
			"Проиграть сцену в тесте",
			"",
			true
		)
		previewAction.Triggered:Connect(togglePreview)
	end)

	if player then
		player.CharacterAdded:Connect(function()
			if state == "idle" and #session == 0 then
				setStatus("Готово к записи", C.text)
				render()
			end
		end)
	end

	plugin.Unloading:Connect(function()
		recorder:stop()
		stopScene()
		hud.gui:Destroy()
	end)

	render()
end

return PlayApp
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Recorder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Samples the local character (root CFrame + every Motor6D.Transform) at a fixed rate.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = script.Parent.Parent.Shared
local Codec = require(Shared.Codec)
local Rig = require(Shared.Rig)
local Appearance = require(script.Parent.Appearance)

local Recorder = {}
Recorder.__index = Recorder

function Recorder.new()
	return setmetatable({ recording = false, elapsed = 0 }, Recorder)
end

function Recorder:start(opts): (boolean, string?)
	local player = Players.LocalPlayer
	local character = player and player.Character
	if not character then
		return false, "Нет персонажа — нужен режим Play (F5)"
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	if not root then
		return false, "У персонажа нет HumanoidRootPart"
	end

	local jointMap = Rig.getJoints(character)
	local parts = {}
	for name in jointMap do
		table.insert(parts, name)
	end
	table.sort(parts)
	local motors = table.create(#parts)
	for i, name in parts do
		motors[i] = jointMap[name]
	end

	local desc = nil
	if humanoid then
		pcall(function()
			desc = Appearance.serialize(humanoid:GetAppliedDescription())
		end)
	end

	local fps = math.clamp(math.floor(opts.fps or 30), 5, 60)
	self.rec = {
		id = Codec.newId(),
		name = opts.name or player.DisplayName,
		fps = fps,
		rig = if humanoid then humanoid.RigType.Name else "R15",
		userId = player.UserId,
		desc = desc,
		parts = parts,
		frames = {},
	}
	self.recording = true
	self.elapsed = 0

	local interval = 1 / fps
	local nextSample = 0
	local frames = self.rec.frames
	local lastJoints = table.create(#motors, CFrame.identity)
	local lastRoot = root.CFrame
	local function sample()
		-- after death or respawn the old parts are gone: hold the last pose
		if root.Parent then
			lastRoot = root.CFrame
			local joints = table.create(#motors)
			for i, motor in motors do
				joints[i] = if motor.Parent then motor.Transform else lastJoints[i]
			end
			lastJoints = joints
		end
		table.insert(frames, { root = lastRoot, joints = lastJoints })
	end
	sample()
	nextSample = interval
	self.conn = RunService.Heartbeat:Connect(function(dt)
		self.elapsed += dt
		-- repeat the current pose on slow frames so frame index always equals time * fps
		while nextSample <= self.elapsed do
			sample()
			nextSample += interval
		end
	end)
	return true, nil
end

function Recorder:stop()
	if not self.recording then
		return nil
	end
	self.recording = false
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	local rec = self.rec
	self.rec = nil
	Codec.computeLength(rec)
	return rec
end

return Recorder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Timeline</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Timeline strip: ruler, camera lane with keyframes, one lane per actor with draggable clips.
local UI = require(script.Parent.UI)
local Shared = script.Parent.Parent.Shared
local SceneData = require(Shared.SceneData)

local C = UI.C
local LABEL_W = 92
local RULER_H = 18
local ROW_H = 22
local RIGHT_PAD = 10
local MAX_VISIBLE_ROWS = 6

local Timeline = {}
Timeline.__index = Timeline

function Timeline.new(app, parent: Instance)
	local self = setmetatable({}, Timeline)
	self.app = app
	self.viewLen = 10
	self.height = RULER_H + ROW_H * 2 + 8

	self.frame = UI.new("Frame", {
		Name = "Timeline",
		BackgroundColor3 = C.panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, self.height),
		Parent = parent,
	})
	UI.corner(self.frame, 6)

	self.ruler = UI.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.panel2,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(LABEL_W, 0),
		Size = UDim2.new(1, -LABEL_W - RIGHT_PAD, 0, RULER_H),
		Parent = self.frame,
	})
	self.ruler.MouseButton1Down:Connect(function()
		self:beginScrub()
	end)
	self.ruler:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:drawTicks()
	end)

	self.rows = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, RULER_H + 4),
		Size = UDim2.new(1, 0, 1, -RULER_H - 4),
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = self.frame,
	})
	UI.list(self.rows, false, 2)

	local overlay = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(LABEL_W, 0),
		Size = UDim2.new(1, -LABEL_W - RIGHT_PAD, 1, 0),
		Interactable = false,
		ZIndex = 20,
		Parent = self.frame,
	})
	self.playhead = UI.new("Frame", {
		BackgroundColor3 = C.record,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0, 2, 1, 0),
		ZIndex = 20,
		Parent = overlay,
	})
	return self
end

function Timeline:timeAtX(x: number, viewLen: number?): number
	local abs = self.ruler.AbsolutePosition.X
	local width = math.max(1, self.ruler.AbsoluteSize.X)
	return math.max(0, (x - abs) / width * (viewLen or self.viewLen))
end

function Timeline:beginScrub()
	local app = self.app
	app:pausePlayback()
	local viewLen = self.viewLen
	app:beginDrag(function(mouse: Vector2)
		app:seek(math.min(self:timeAtX(mouse.X, viewLen), app.playback:length()))
	end, function() end)
end

function Timeline:beginClipDrag(actor: Instance)
	local app = self.app
	local viewLen = self.viewLen
	local startOffset = actor:GetAttribute("Offset") or 0
	local startX = app.widget:GetRelativeMousePosition().X
	local moved = false
	app:selectActor(actor, true)
	app:beginDrag(function(mouse: Vector2)
		local dx = mouse.X - startX
		if math.abs(dx) < 3 and not moved then
			return
		end
		moved = true
		local width = math.max(1, self.ruler.AbsoluteSize.X)
		local offset = math.max(0, startOffset + dx / width * viewLen)
		offset = math.floor(offset * 20 + 0.5) / 20
		actor:SetAttribute("Offset", offset)
		app.playback:evaluate(app.playback.time)
	end, function()
		if not moved then
			app:render()
			return
		end
		-- re-apply the final value inside an undo recording
		local final = actor:GetAttribute("Offset")
		actor:SetAttribute("Offset", startOffset)
		app:mutate("сдвиг клипа", function()
			actor:SetAttribute("Offset", final)
		end)
	end)
end

function Timeline:drawTicks()
	for _, child in self.ruler:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local width = self.ruler.AbsoluteSize.X
	if width <= 0 then
		return
	end
	local step = 60
	for _, s in { 0.25, 0.5, 1, 2, 5, 10, 15, 30, 60 } do
		if s / self.viewLen * width >= 48 then
			step = s
			break
		end
	end
	local t = 0
	while t <= self.viewLen do
		local x = t / self.viewLen
		UI.new("Frame", {
			BackgroundColor3 = C.dim,
			BorderSizePixel = 0,
			Position = UDim2.new(x, 0, 1, -5),
			Size = UDim2.new(0, 1, 0, 5),
			Parent = self.ruler,
		})
		UI.new("TextLabel", {
			BackgroundTransparency = 1,
			Text = UI.formatNumber(t) .. "с",
			TextColor3 = C.dim,
			TextSize = 11,
			Font = UI.FONT,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.new(x, 3, 0, 0),
			Size = UDim2.new(0, 40, 1, -4),
			Parent = self.ruler,
		})
		t += step
	end
end

function Timeline:makeRow(labelText: string, color: Color3?, onLabel: (() -> ())?)
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, ROW_H),
		Parent = self.rows,
	})
	UI.new("TextButton", {
		Text = "  " .. labelText,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		TextColor3 = color or C.text,
		TextSize = 12,
		Font = UI.FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(0, LABEL_W - 4, 1, 0),
		Parent = row,
	}).Activated:Connect(function()
		if onLabel then
			onLabel()
		end
	end)
	local lane = UI.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.input,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(LABEL_W, 0),
		Size = UDim2.new(1, -LABEL_W - RIGHT_PAD, 1, 0),
		Parent = row,
	})
	lane.MouseButton1Down:Connect(function()
		self:beginScrub()
	end)
	return lane
end

function Timeline:rebuild()
	for _, child in self.rows:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local app = self.app
	local root = SceneData.getRoot(false)
	local length = app.playback:length()
	self.viewLen = math.max(length, 5) * 1.05
	local viewLen = self.viewLen

	-- camera lane
	local camLane = self:makeRow("Камера", C.warn, function()
		app:setTab("camera")
	end)
	if root then
		for i, key in SceneData.getCamera(root).keys do
			local selected = app.tab == "camera" and app.selectedKey == i
			local diamond = UI.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = if key.ease == "cut" then C.record elseif selected then Color3.new(1, 1, 1) else C.warn,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(key.t / viewLen, 0, 0.5, 0),
				Size = UDim2.fromOffset(9, 9),
				Rotation = 45,
				ZIndex = 3,
				Parent = camLane,
			})
			diamond.Activated:Connect(function()
				app.selectedKey = i
				app:setTab("camera")
				app:seek(key.t)
			end)
		end
	end

	local actors = if root then SceneData.listActors(root) else {}
	for _, actor in actors do
		local color = actor:GetAttribute("Color") or C.accent
		local enabled = actor:GetAttribute("Enabled") ~= false
		local lane = self:makeRow(SceneData.getName(actor), if enabled then C.text else C.dim, function()
			app:selectActor(actor)
		end)
		local offset = actor:GetAttribute("Offset") or 0
		local len = math.max(SceneData.actorLength(actor), 0.05)
		local clip = UI.new("TextButton", {
			Text = " " .. SceneData.getName(actor),
			AutoButtonColor = false,
			BackgroundColor3 = color,
			BackgroundTransparency = if enabled then 0.15 else 0.65,
			BorderSizePixel = 0,
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 11,
			Font = UI.FONT_BOLD,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(offset / viewLen, 0, 0, 2),
			Size = UDim2.new(len / viewLen, 0, 1, -4),
			ClipsDescendants = true,
			ZIndex = 2,
			Parent = lane,
		})
		UI.corner(clip, 3)
		UI.new("UISizeConstraint", { MinSize = Vector2.new(4, 0), Parent = clip })
		if actor == app.selected then
			UI.new("UIStroke", {
				Color = Color3.new(1, 1, 1),
				Thickness = 1.5,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Parent = clip,
			})
		end
		for _, key in SceneData.getSkinKeys(actor) do
			if key.t >= 0 and key.t <= len then
				UI.new("Frame", {
					BackgroundColor3 = if key.skin == SceneData.HIDDEN_SKIN then C.record else Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					Position = UDim2.new(key.t / len, 0, 0, 0),
					Size = UDim2.new(0, 2, 1, 0),
					ZIndex = 3,
					Parent = clip,
				})
			end
		end
		clip.MouseButton1Down:Connect(function()
			self:beginClipDrag(actor)
		end)
	end

	local rowCount = 1 + #actors
	local height = RULER_H + 4 + math.min(rowCount, MAX_VISIBLE_ROWS) * (ROW_H + 2) + 4
	if height ~= self.height then
		self.height = height
		self.frame.Size = UDim2.new(self.frame.Size.X.Scale, self.frame.Size.X.Offset, 0, height)
		if self.onHeightChanged then
			self.onHeightChanged()
		end
	end
	self:drawTicks()
	self:updatePlayhead(app.playback.time)
end

function Timeline:updatePlayhead(t: number)
	self.playhead.Position = UDim2.new(math.clamp(t / self.viewLen, 0, 1), 0, 0, 0)
end

return Timeline
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Tiny widget toolkit for the plugin windows.
local UI = {}

local C = {
	bg = Color3.fromRGB(30, 31, 36),
	panel = Color3.fromRGB(40, 42, 48),
	panel2 = Color3.fromRGB(54, 56, 64),
	input = Color3.fromRGB(22, 23, 27),
	text = Color3.fromRGB(232, 234, 240),
	dim = Color3.fromRGB(150, 154, 166),
	accent = Color3.fromRGB(70, 120, 235),
	good = Color3.fromRGB(60, 160, 100),
	danger = Color3.fromRGB(190, 65, 65),
	record = Color3.fromRGB(235, 60, 60),
	warn = Color3.fromRGB(240, 185, 60),
}
UI.C = C
UI.FONT = Enum.Font.BuilderSans
UI.FONT_BOLD = Enum.Font.BuilderSansBold

local layoutOrder = 0
local toggles = setmetatable({}, { __mode = "k" })

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if inst:IsA("GuiObject") then
		layoutOrder += 1
		inst.LayoutOrder = layoutOrder
	end
	for k, v in (props or {}) :: { [string]: any } do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function merge(base, extra)
	for k, v in extra or {} do
		base[k] = v
	end
	return base
end

function UI.corner(inst: Instance, radius: number?)
	UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 4), Parent = inst })
	return inst
end

function UI.pad(inst: Instance, l: number, r: number, t: number, b: number)
	UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, l),
		PaddingRight = UDim.new(0, r),
		PaddingTop = UDim.new(0, t),
		PaddingBottom = UDim.new(0, b),
		Parent = inst,
	})
	return inst
end

function UI.list(inst: Instance, horizontal: boolean?, spacing: number?)
	UI.new("UIListLayout", {
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		Padding = UDim.new(0, spacing or 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top,
		Parent = inst,
	})
	return inst
end

function UI.flex(inst: Instance)
	UI.new("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = inst })
	return inst
end

function UI.label(text: string, props: { [string]: any }?): TextLabel
	return UI.new(
		"TextLabel",
		merge({
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = C.text,
			Font = UI.FONT,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, 0, 0, 20),
		}, props)
	)
end

function UI.paragraph(text: string, props: { [string]: any }?): TextLabel
	return UI.label(
		text,
		merge({
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextColor3 = C.dim,
			TextSize = 13,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
		}, props)
	)
end

function UI.recolor(button: GuiObject, color: Color3)
	button:SetAttribute("BaseColor", color)
	button.BackgroundColor3 = color
end

function UI.button(text: string, onClick: ((TextButton) -> ())?, props: { [string]: any }?): TextButton
	local b = UI.new(
		"TextButton",
		merge({
			Text = text,
			AutoButtonColor = false,
			BackgroundColor3 = C.panel2,
			TextColor3 = C.text,
			Font = UI.FONT,
			TextSize = 13,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 0, 0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
		}, props)
	)
	UI.corner(b, 4)
	UI.pad(b, 8, 8, 0, 0)
	b:SetAttribute("BaseColor", b.BackgroundColor3)
	b.MouseEnter:Connect(function()
		local base = b:GetAttribute("BaseColor") or C.panel2
		b.BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12)
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = b:GetAttribute("BaseColor") or C.panel2
	end)
	if onClick then
		b.Activated:Connect(function()
			onClick(b)
		end)
	end
	return b
end

function UI.textbox(text: any, onCommit: ((string, TextBox) -> ())?, props: { [string]: any }?): TextBox
	local tb = UI.new(
		"TextBox",
		merge({
			Text = tostring(text),
			ClearTextOnFocus = false,
			BackgroundColor3 = C.input,
			TextColor3 = C.text,
			PlaceholderColor3 = C.dim,
			Font = UI.FONT,
			TextSize = 13,
			BorderSizePixel = 0,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(0, 60, 0, 24),
		}, props)
	)
	UI.corner(tb, 4)
	UI.pad(tb, 6, 6, 0, 0)
	if onCommit then
		tb.FocusLost:Connect(function()
			onCommit(tb.Text, tb)
		end)
	end
	return tb
end

local function paintToggle(b: TextButton)
	local info = toggles[b]
	b.Text = (if info.value then "✓ " else "") .. info.text
	UI.recolor(b, if info.value then C.accent else C.panel2)
end

function UI.toggle(text: string, value: boolean, onChange: (boolean) -> (), props: { [string]: any }?): TextButton
	local b = UI.button(text, nil, props)
	toggles[b] = { value = value, text = text }
	paintToggle(b)
	b.Activated:Connect(function()
		local info = toggles[b]
		info.value = not info.value
		paintToggle(b)
		onChange(info.value)
	end)
	return b
end

function UI.setToggle(b: TextButton, value: boolean)
	local info = toggles[b]
	if info and info.value ~= value then
		info.value = value
		paintToggle(b)
	end
end

-- options = { { value = any, label = string } }; click cycles to the next option.
function UI.cycle(options, current: any, onChange: (any) -> (), props: { [string]: any }?): TextButton
	local index = 1
	for i, opt in options do
		if opt.value == current then
			index = i
		end
	end
	local b
	b = UI.button(options[index].label, function()
		index = index % #options + 1
		b.Text = options[index].label
		onChange(options[index].value)
	end, props)
	return b
end

function UI.row(children: { Instance }, props: { [string]: any }?): Frame
	local row = UI.new(
		"Frame",
		merge({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 26),
		}, props)
	)
	UI.list(row, true, 4)
	for _, child in children do
		child.Parent = row
	end
	return row
end

function UI.section(title: string?, parent: Instance): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = C.panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	})
	UI.corner(f, 6)
	UI.pad(f, 8, 8, 8, 8)
	UI.list(f, false, 6)
	if title then
		UI.label(title, { Font = UI.FONT_BOLD, TextSize = 15, Parent = f })
	end
	return f
end

function UI.clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function UI.formatTime(t: number): string
	t = math.max(0, t)
	local m = math.floor(t / 60)
	return string.format("%d:%05.2f", m, t - m * 60)
end

function UI.formatNumber(n: number): string
	local s = string.format("%.2f", n)
	s = (string.gsub(s, "0+$", ""))
	s = (string.gsub(s, "%.$", ""))
	return s
end

function UI.parseNumber(text: string): number?
	local cleaned = string.gsub(text, ",", ".")
	return tonumber(cleaned)
end

function UI.createWidget(plugin: Plugin, id: string, info: DockWidgetPluginGuiInfo): DockWidgetPluginGui
	local ok, widget = pcall(function()
		return plugin:CreateDockWidgetPluginGuiAsync(id, info)
	end)
	if ok and widget then
		return widget
	end
	return plugin:CreateDockWidgetPluginGui(id, info)
end

return UI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Version</string>
          <string name="Source"><![CDATA[--!nonstrict
local Version = {}

Version.NUMBER = "0.3.0"
Version.LABEL = "BBS Studio v" .. Version.NUMBER

return Version
